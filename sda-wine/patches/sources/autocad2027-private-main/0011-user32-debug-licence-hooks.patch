 INT WINAPI MessageBoxIndirectW( LPMSGBOXPARAMSW msgbox )
 {
+    /* project debug: report who shows the "License manager is not functioning" message box */
+    if (msgbox && msgbox->lpszText && !IS_INTRESOURCE(msgbox->lpszText))
+    {
+        WCHAR buf[512];
+        void *frames[64];
+        USHORT i, n;
+
+        lstrcpynW( buf, msgbox->lpszText, 511 );
+        if (wcsstr( buf, L"License manager" ) || wcsstr( buf, L"license manager" ))
+        {
+            fprintf( stderr, "LICMSGBOX pid=%lu text=%ls\n", GetCurrentProcessId(), buf );
+            n = RtlCaptureStackBackTrace( 0, 64, frames, NULL );
+            for (i = 0; i < n; i++)
+            {
+                HMODULE mod = NULL;
+                char name[MAX_PATH] = "?";
+
+                if (GetModuleHandleExA( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                        GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                        (LPCSTR)frames[i], &mod ))
+                {
+                    GetModuleFileNameA( mod, name, sizeof(name) );
+                    fprintf( stderr, "LICMSGBOX  #%u %p %s+%#llx\n", i, frames[i], name,
+                             (unsigned long long)((const char *)frames[i] - (const char *)mod) );
+                }
+                else
+                    fprintf( stderr, "LICMSGBOX  #%u %p <unknown>\n", i, frames[i] );
+            }
+            fflush( stderr );
+        }
+    }
     LPVOID tmplate;
     HRSRC hRes;
     int ret;
