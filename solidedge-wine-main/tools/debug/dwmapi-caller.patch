+/* DEBUG ONLY: name the module that called us, so a FIXME can be attributed to a library
+ * without a relay trace.  Not part of the series. */
+static void log_caller(DWORD attribute, HWND hwnd)
+{
+    HMODULE module = NULL;
+    WCHAR path[MAX_PATH];
+    void *caller = __builtin_return_address(0);
+
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                            GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (const WCHAR *)caller, &module))
+        return;
+    if (!GetModuleFileNameW(module, path, ARRAY_SIZE(path)))
+        return;
+    WARN("attribute %lu on hwnd %p came from %p in %s\n", attribute, hwnd, caller,
+         wine_dbgstr_w(path));
+}
+
