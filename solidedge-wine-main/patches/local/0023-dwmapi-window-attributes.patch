         SetThreadDpiAwarenessContext(context);
         break;
     }
+    case DWMWA_CAPTION_BUTTON_BOUNDS:
+    {
+        /* Coordinates are relative to the window's top left corner.  Derived from the non-client
+         * metrics rather than measured; no caller in the applications this fork targets reads it. */
+        RECT *rect = (RECT *)pv_attribute;
+        RECT window;
+        int button_width = GetSystemMetrics(SM_CXSIZE) + GetSystemMetrics(SM_CXPADDEDBORDER);
