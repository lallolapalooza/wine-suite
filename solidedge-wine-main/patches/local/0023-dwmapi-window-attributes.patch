 }
 
 /**********************************************************************
+ *           DWM window attribute storage         (internal)
+ *
+ * Windows keeps the DwmSetWindowAttribute values with the window and returns them again from
+ * DwmGetWindowAttribute -- measured on Windows 11: `DwmSetWindowAttribute(hwnd,
+ * DWMWA_USE_IMMERSIVE_DARK_MODE, &1, 4)` makes `DwmGetWindowAttribute(hwnd, 20, &v, 4)` report
+ * 1, and the same for DWMWA_WINDOW_CORNER_PREFERENCE (structurally 19 on old builds, 33 now).
+ * Wine had no storage at all and answered E_NOTIMPL for every attribute but
+ * DWMWA_EXTENDED_FRAME_BOUNDS, so the value could never round-trip.
+ *
+ * Kept as window properties: they live and die with the window and, because Wine's properties
+ * are server-side, they are visible to other processes' dwmapi just as Windows' are.
+ */
+static void attribute_name(DWORD attribute, WCHAR *buffer, unsigned int len)
+{
+    static const WCHAR fmt[] = L"__wine_dwm_attr_%lu";
+
+    wsprintfW(buffer, fmt, attribute);
+}
+
+static BOOL get_stored_attribute(HWND hwnd, DWORD attribute, DWORD *value)
+{
+    WCHAR name[32];
+    HANDLE prop;
+
+    attribute_name(attribute, name, ARRAY_SIZE(name));
+    if (!(prop = GetPropW(hwnd, name))) return FALSE;
+    *value = (DWORD)(ULONG_PTR)prop - 1; /* stored as value + 1, so that 0 is distinguishable */
+    return TRUE;
+}
+
+static void set_stored_attribute(HWND hwnd, DWORD attribute, DWORD value)
+{
+    WCHAR name[32];
+
+    attribute_name(attribute, name, ARRAY_SIZE(name));
+    SetPropW(hwnd, name, (HANDLE)(ULONG_PTR)(value + 1));
+}
+
+/* Read one of the DWORD-valued attributes: `size` must be at least a DWORD and the result is
+ * the stored value, or `default_value` when the attribute was never set. */
+static HRESULT get_dword_attribute(HWND hwnd, DWORD attribute, PVOID pv_attribute, DWORD size,
+                                   DWORD default_value)
+{
+    DWORD *value = pv_attribute;
+    DWORD stored;
+
+    if (!value)
+        return E_INVALIDARG;
+    if (size < sizeof(*value))
+        return E_INVALIDARG;
+    *value = get_stored_attribute(hwnd, attribute, &stored) ? stored : default_value;
+    return S_OK;
+}
+
+/**********************************************************************
  *           DwmSetWindowAttribute         (DWMAPI.@)
+ *
+ * Everything is accepted with S_OK, as Windows does for the attributes it cannot read back
+ * (measured: setting DWMWA_BORDER_COLOR succeeds while getting it answers E_INVALIDARG), but
+ * the DWORD-valued attributes Windows does return again are stored so they round trip.
  */
 HRESULT WINAPI DwmSetWindowAttribute(HWND hwnd, DWORD attributenum, LPCVOID attribute, DWORD size)
 {
     static BOOL once;
 
-    if (!once++) FIXME("(%p, %lx, %p, %lx) stub\n", hwnd, attributenum, attribute, size);
+    if (!once++) TRACE("(%p, %lx, %p, %lx)\n", hwnd, attributenum, attribute, size);
+
+    if (!IsWindow(hwnd))
+        return E_HANDLE;
+
+    switch (attributenum) {
+    case DWMWA_NCRENDERING_ENABLED:
+    case DWMWA_FREEZE_REPRESENTATION:
+    case DWMWA_PASSIVE_UPDATE_MODE:
+    case DWMWA_WINDOW_CORNER_PREFERENCE:
+    case DWMWA_USE_IMMERSIVE_DARK_MODE:
+    case DWMWA_SYSTEMBACKDROP_TYPE:
+        if (!attribute || size < sizeof(DWORD))
+            return E_INVALIDARG;
+        set_stored_attribute(hwnd, attributenum, *(const DWORD *)attribute);
+        break;
+    default:
+        break;
+    }
 
     return S_OK;
 }
