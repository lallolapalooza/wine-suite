+/* The attributes Windows answers with S_OK.  Measured on Windows 11 26200 with
+ * tools/winapi/dwmprobe.c: every one of these returns S_OK with a DWORD (or a RECT for
+ * DWMWA_CAPTION_BUTTON_BOUNDS), the DWORD ones reject a buffer smaller than a DWORD with
+ * E_INVALIDARG, and an attribute Windows does not know is E_INVALIDARG -- never E_NOTIMPL.
+ * .NET's UIAutomationClient!IsWindowCloaked() reads DWMWA_CLOAKED exactly like this. */
+static void test_DWMWA_attributes(void)
+{
+    BOOL enabled;
+    HRESULT hr;
+    HWND hwnd, child;
+    DWORD value;
+    RECT rect;
+
+    hwnd = CreateWindowW(L"static", L"static", WS_OVERLAPPEDWINDOW | WS_VISIBLE,
+                         10, 10, 200, 200, NULL, NULL, NULL, NULL);
+    child = CreateWindowW(L"edit", L"edit", WS_CHILD | WS_VISIBLE, 0, 0, 50, 50, hwnd, NULL, NULL, NULL);
+
+    DwmIsCompositionEnabled(&enabled);
+    if (!enabled)
+    {
+        skip("DWM is disabled.\n");
+        goto cleanup;
+    }
+
+    value = 0xdeadbeef;
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, &value, sizeof(value));
+    if (hr == E_INVALIDARG)
+    {
+        skip("DWMWA_CLOAKED is not supported on this Windows version.\n");
+        goto cleanup;
+    }
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!value, "Got cloaked %lu.\n", value);
+
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, NULL, sizeof(value));
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, &value, 0);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(NULL, DWMWA_CLOAKED, &value, sizeof(value));
+    ok(hr == E_HANDLE, "Got hr %#lx.\n", hr);
+
+    /* attributes Windows does not know */
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_NCRENDERING_POLICY, &value, sizeof(value));
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CLOAK, &value, sizeof(value));
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_NCRENDERING_ENABLED, &value, sizeof(value));
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(value != 0, "Got %lu.\n", value);
+
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_FREEZE_REPRESENTATION, &value, sizeof(value));
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!value, "Got %lu.\n", value);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_PASSIVE_UPDATE_MODE, &value, sizeof(value));
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!value, "Got %lu.\n", value);
+
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, &value, sizeof(value));
+    ok(hr == S_OK || broken(hr == E_INVALIDARG) /* Win7/8 */, "Got hr %#lx.\n", hr);
+
+    /* this one takes exactly a DWORD and reports a 1 pixel frame */
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_VISIBLE_FRAME_BORDER_THICKNESS, &value, sizeof(value));
+    if (hr != E_INVALIDARG)
+    {
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        ok(value == 1, "Got %lu.\n", value);
+        hr = DwmGetWindowAttribute(hwnd, DWMWA_VISIBLE_FRAME_BORDER_THICKNESS, &rect, sizeof(rect));
+        ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+    }
+
+    /* DWMWA_CAPTION_BUTTON_BOUNDS is a RECT */
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CAPTION_BUTTON_BOUNDS, &value, sizeof(value));
+    ok(hr == E_NOT_SUFFICIENT_BUFFER, "Got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CAPTION_BUTTON_BOUNDS, &rect, sizeof(rect));
+    ok(hr == S_OK || broken(hr == E_HANDLE) /* no caption on some hosts */, "Got hr %#lx.\n", hr);
+
+    /* what was set comes back */
+    value = 1;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, &value, sizeof(value));
+    ok(hr == S_OK || broken(hr == E_INVALIDARG), "Got hr %#lx.\n", hr);
+    value = 0xdeadbeef;
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, &value, sizeof(value));
+    if (hr == S_OK)
+        ok(value == 1, "Got %lu.\n", value);
+
+    value = 2;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    ok(hr == S_OK || broken(hr == E_INVALIDARG), "Got hr %#lx.\n", hr);
+    value = 0xdeadbeef;
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    if (hr == S_OK)
+        ok(value == 2, "Got %lu.\n", value);
+
+    /* a child window is not cloaked either, but has no DWM frame */
+    value = 0xdeadbeef;
+    hr = DwmGetWindowAttribute(child, DWMWA_CLOAKED, &value, sizeof(value));
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(!value, "Got %lu.\n", value);
+    hr = DwmGetWindowAttribute(child, DWMWA_EXTENDED_FRAME_BOUNDS, &rect, sizeof(rect));
+    ok(hr == E_HANDLE, "Got hr %#lx.\n", hr);
+
+cleanup:
+    DestroyWindow(child);
+    DestroyWindow(hwnd);
+}
+
 static void WINAPI apc_func(ULONG_PTR apc_count)
 {
     ++*(unsigned int *)apc_count;
@@ -175,5 +282,6 @@
     test_DwmIsCompositionEnabled();
     test_DwmGetCompositionTimingInfo();
     test_DWMWA_EXTENDED_FRAME_BOUNDS();
+    test_DWMWA_attributes();
     test_DwmFlush();
 }
