+    case DWMWA_SYSTEMBACKDROP_TYPE:
+        hr = get_dword_attribute(hwnd, attribute, pv_attribute, size, 0);
+        break;
+    case DWMWA_CLOAKED:
+        /* Not cloaked: Wine has no virtual desktops and does not suspend windows.  Windows
+         * answers S_OK with 0 here, and .NET's UIAutomationClient reads exactly this call in
+         * IsWindowCloaked(); answering E_NOTIMPL made it fall into its error path. */
+        hr = get_dword_attribute(hwnd, attribute, pv_attribute, size, 0);
+        break;
+    case DWMWA_WINDOW_CORNER_PREFERENCE:
+    case DWMWA_USE_IMMERSIVE_DARK_MODE:
+        /* DWMWCP_DEFAULT / dark mode off until the application asks for something else. */
+        hr = get_dword_attribute(hwnd, attribute, pv_attribute, size, 0);
+        break;
+    case DWMWA_VISIBLE_FRAME_BORDER_THICKNESS:
+    {
+        /* Windows requires exactly a DWORD here (a 16 byte buffer is rejected), and a window
+         * styled with a system frame always has a 1 pixel visible border. */
+        DWORD *value = pv_attribute;
+
+        if (!value)
+            return E_INVALIDARG;
+        if (size != sizeof(*value))
+            return E_INVALIDARG;
+        *value = 1;
+        hr = S_OK;
+        break;
+    }
     default:
-        FIXME("attribute %ld not implemented.\n", attribute);
-        hr = E_NOTIMPL;
+        /* Windows answers E_INVALIDARG for the attributes it does not know; E_NOTIMPL is a
+         * different thing and callers that switch on the result treat it as a Wine-only case. */
+        WARN("attribute %ld not supported.\n", attribute);
+        hr = E_INVALIDARG;
         break;
     }
 
