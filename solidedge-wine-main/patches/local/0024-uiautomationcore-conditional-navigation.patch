+        /* The first (or last) child is not the one asked for; continue along its siblings. */
+        hr = conditional_navigate_siblings(unsafe_impl_from_IWineUiaNode((IWineUiaNode *)child),
+                nav_dir == NavigateDirection_FirstChild ? NavigateDirection_NextSibling
+                                                        : NavigateDirection_PreviousSibling,
+                cond, out_node);
+        UiaNodeRelease(child);
+        break;
+    }
+
+    case NavigateDirection_NextSibling:
+    case NavigateDirection_PreviousSibling:
+        hr = conditional_navigate_siblings(node, nav_dir, cond, out_node);
         break;
 
