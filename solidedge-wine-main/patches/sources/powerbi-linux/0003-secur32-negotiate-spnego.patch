+/* The sub-package hands its user-mode context data up on the call where it creates its context; keep a copy.
+ * The caller (secur32) replaces its context object on every round and the user-mode half registers itself
+ * under that object's address (lsa.c: LSA_USER_HANDLE(&handle)), so a round the mechanism itself produces no
+ * mapping for - which is exactly the extra round SPNEGO adds after the mechanism has finished - would leave
+ * the caller's new object unregistered, and sealing would then fail with SEC_E_INVALID_HANDLE. */
+static void save_user_data( struct sec_handle *ctxt, const SecBuffer *context_data )
+{
+    BYTE *copy;
+
+    if (!context_data->cbBuffer || !context_data->pvBuffer) return;
+    if (!(copy = malloc( context_data->cbBuffer ))) return;
+    memcpy( copy, context_data->pvBuffer, context_data->cbBuffer );
+    free( ctxt->user_data );
+    ctxt->user_data = copy;
+    ctxt->user_data_len = context_data->cbBuffer;
+    ctxt->user_ssp = ctxt->krb ? SSP_KERBEROS : SSP_NTLM;
+}
+
+/* Wrap a sub-package context blob in the struct user_context_data the user-mode half expects, and hand the
+ * caller the mapping for this round's context object. */
+static BOOL publish_user_data( const BYTE *blob, ULONG len, ULONG ssp, SecBuffer *context_data )
+{
+    struct user_context_data *data = lsa_funcs->AllocateLsaHeap( sizeof(*data) + len );
+
+    if (!data) return FALSE;
+    data->ssp = ssp;
+    memcpy( data + 1, blob, len );
+    context_data->cbBuffer = len + sizeof(*data);
+    context_data->pvBuffer = data;
+    return TRUE;
+}
