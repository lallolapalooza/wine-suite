+static void set_output_token( SecBufferDesc *output, int idx, BYTE *mem, ULONG len )
+{
+    output->pBuffers[idx].pvBuffer = mem;
+    output->pBuffers[idx].cbBuffer = len;
+    output->pBuffers[idx].BufferType = (output->pBuffers[idx].BufferType & SECBUFFER_ATTRMASK)
+            | SECBUFFER_TOKEN | SECBUFFER_UNMAPPED;
+}
+
+static void set_empty_output( SecBufferDesc *output, int idx )
+{
+    output->pBuffers[idx].pvBuffer = NULL;
+    output->pBuffers[idx].cbBuffer = 0;
+    output->pBuffers[idx].BufferType = SECBUFFER_TOKEN;
