+/* The peer's message, mapped into LSA memory.  `client' is the caller's own buffer holding the same bytes: the
+ * sub-package reads its token from the calling process, so the inner token has to be handed to it as an offset
+ * into that buffer rather than as a pointer into our copy. */
+struct nego_input
+{
+    const BYTE *mapped;
+    ULONG len;
+    BYTE *client;
+};
+
+static int token_buffer_index( SecBufferDesc *desc )
+{
+    int i;
+
+    if (!desc || !desc->cBuffers) return -1;
+    for (i = 0; i < desc->cBuffers; i++)
+        if (desc->pBuffers[i].BufferType == SECBUFFER_TOKEN) return i;
+    return 0;
+}
+
+static NTSTATUS map_nego_input( SecBufferDesc *input, struct nego_input *in )
+{
+    SecBuffer *buf;
+    int idx;
+
+    in->mapped = NULL;
+    in->len = 0;
+    in->client = NULL;
+    if (!input || (idx = token_buffer_index( input )) == -1) return SEC_E_INVALID_TOKEN;
+    buf = &input->pBuffers[idx];
+    if (!buf->pvBuffer || !buf->cbBuffer) return SEC_E_INVALID_TOKEN;
+    in->client = buf->pvBuffer;
+    if (buf->BufferType & SECBUFFER_UNMAPPED)
+    {
+        in->mapped = buf->pvBuffer;
+    }
+    else
+    {
+        NTSTATUS status = lsa_funcs->MapBuffer( buf, buf );
+
+        if (status) return status;
+        in->mapped = buf->pvBuffer;
+    }
+    in->len = buf->cbBuffer;
+    return SEC_E_OK;
+}
+
+/* A descriptor for the mechanism token inside the peer's message, pointing into the caller's buffer. */
+static SecBufferDesc *sub_input_desc( struct nego_input *peer, const BYTE *token, ULONG token_len,
+                                      SecBuffer *buf, SecBufferDesc *desc )
+{
+    if (!token) return NULL;
+    buf->pvBuffer = peer->client + (token - peer->mapped);
+    buf->cbBuffer = token_len;
+    buf->BufferType = SECBUFFER_TOKEN;
+    desc->ulVersion = SECBUFFER_VERSION;
+    desc->cBuffers = 1;
+    desc->pBuffers = buf;
+    return desc;
+}
+
+/* The sub-package returns its token in a buffer on the LSA heap (see lsa_MapBuffer); take a copy and drop it,
+ * because the Negotiate package has to replace it with the framed token. */
+static NTSTATUS take_sub_output( SecBufferDesc *output, int idx, void *client_ptr, BYTE **token, ULONG *len )
+{
+    SecBuffer *buf = &output->pBuffers[idx];
+
+    *token = NULL;
+    *len = 0;
+    if (!buf->pvBuffer || !buf->cbBuffer) return SEC_E_OK;
+    if (!(*token = malloc( buf->cbBuffer ))) return SEC_E_INSUFFICIENT_MEMORY;
+    memcpy( *token, buf->pvBuffer, buf->cbBuffer );
+    *len = buf->cbBuffer;
+    if (buf->pvBuffer != client_ptr) lsa_funcs->FreeLsaHeap( buf->pvBuffer );
+    buf->pvBuffer = NULL;
+    buf->cbBuffer = 0;
+    return SEC_E_OK;
+}
