+/* a0 { 30 { 06 <oid> } } - a MechTypeList holding the single mechanism Wine can negotiate */
+static ULONG mech_types_size( ULONG oid_len )
+{
+    return der_tlv_size( der_tlv_size( der_tlv_size( oid_len )));
+}
+
+/* a2 { 04 <token> } */
+static ULONG mech_token_size( ULONG token_len )
+{
+    return der_tlv_size( der_tlv_size( token_len ));
+}
+
+static ULONG spnego_init_size( ULONG oid_len, ULONG token_len )
+{
+    ULONG neg_init = der_tlv_size( mech_types_size( oid_len ) + mech_token_size( token_len ));
+
+    return der_tlv_size( der_tlv_size( sizeof(oid_spnego) ) + der_tlv_size( neg_init ));
+}
+
+static ULONG spnego_resp_size( int neg_state, BOOL supported_mech, ULONG oid_len, ULONG token_len )
+{
+    ULONG content = 0;
+
+    if (neg_state >= 0) content += der_tlv_size( 3 );                      /* a0 { 0a 01 <state> } */
+    if (supported_mech) content += der_tlv_size( der_tlv_size( oid_len )); /* a1 { 06 <oid> } */
+    if (token_len) content += der_tlv_size( der_tlv_size( token_len ));    /* a2 { 04 <token> } */
+    return der_tlv_size( der_tlv_size( content ));
+}
+
+static ULONG spnego_encode_init( BYTE *buf, const BYTE *oid, ULONG oid_len, const BYTE *token, ULONG token_len )
+{
+    ULONG mech_types = mech_types_size( oid_len );
+    ULONG fields = mech_types + mech_token_size( token_len );
+    ULONG neg_init = der_tlv_size( fields );
+    ULONG content = der_tlv_size( sizeof(oid_spnego) ) + der_tlv_size( neg_init );
+    BYTE *p = buf;
+
+    p = der_put_tlv( p, 0x60, content );
+    p = der_put_octets( p, 0x06, oid_spnego, sizeof(oid_spnego) );
+    /* NegTokenInit, [0] around its SEQUENCE - the shape Windows emits and every SPNEGO peer expects */
+    p = der_put_tlv( p, 0xa0, neg_init );
+    p = der_put_tlv( p, 0x30, fields );
+    p = der_put_tlv( p, 0xa0, der_tlv_size( der_tlv_size( oid_len )));
+    p = der_put_tlv( p, 0x30, der_tlv_size( oid_len ));
+    p = der_put_octets( p, 0x06, oid, oid_len );
+    p = der_put_tlv( p, 0xa2, der_tlv_size( token_len ));
+    p = der_put_octets( p, 0x04, token, token_len );
+    return p - buf;
+}
+
+static ULONG spnego_encode_resp( BYTE *buf, int neg_state, const BYTE *oid, ULONG oid_len,
+                                 const BYTE *token, ULONG token_len )
+{
+    ULONG content = 0;
+    BYTE *p = buf;
+
+    if (neg_state >= 0) content += der_tlv_size( 3 );
+    if (oid) content += der_tlv_size( der_tlv_size( oid_len ));
+    if (token_len) content += der_tlv_size( der_tlv_size( token_len ));
+
+    p = der_put_tlv( p, 0xa1, der_tlv_size( content ));
+    p = der_put_tlv( p, 0x30, content );
