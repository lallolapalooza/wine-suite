+/* NameUserPrincipal and NameDnsDomain are composed from the domain the account is in: "user@dns.domain"
+ * and "dns.domain\user".  Wine has no directory to take a user principal name from and uses the machine's
+ * DNS domain, which is the same value GetComputerNameExW( ComputerNameDnsDomain ) reports.  On a machine
+ * that is in no domain these two formats keep answering ERROR_NONE_MAPPED - "If the user account is not in
+ * a domain, only NameSamCompatible is supported" - so the test puts the machine in a domain when it is in
+ * none, which is what makes the answering branch reachable on every host, and restores the value after. */
+static void testGetUserNameEx_domain(void)
+{
+    static const WCHAR params_key[] = L"System\\CurrentControlSet\\Services\\Tcpip\\Parameters";
+    static const WCHAR domain_value[] = L"Domain";
+    static const WCHAR test_domain[] = L"wine.test.example";
+    static const EXTENDED_NAME_FORMAT fmts[] = { NameUserPrincipal, NameDnsDomain };
+    WCHAR user[256], domain[256], name[256], old_domain[256];
+    DWORD user_len = ARRAY_SIZE(user), domain_len, old_len, old_type;
+    BOOL have_domain, have_old_domain = FALSE;
+    ULONG size, len;
+    HKEY key;
+    UINT i;
+    BOOLEAN rc;
+
+    if (!GetUserNameW( user, &user_len ))
+    {
+        win_skip( "GetUserNameW failed: %lu\n", GetLastError() );
+        return;
+    }
+    user_len = lstrlenW( user );
+
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, params_key, 0, KEY_READ | KEY_WRITE, &key ))
+    {
+        old_len = sizeof(old_domain);
+        if (!RegQueryValueExW( key, domain_value, NULL, &old_type, (BYTE *)old_domain, &old_len ))
+            have_old_domain = TRUE;
+        if (RegSetValueExW( key, domain_value, 0, REG_SZ, (const BYTE *)test_domain, sizeof(test_domain) ))
+            trace( "could not set the DNS domain (error %lu), using the machine's own\n", GetLastError() );
+        RegCloseKey( key );
+    }
+
+    domain_len = ARRAY_SIZE(domain);
+    have_domain = GetComputerNameExW( ComputerNameDnsDomain, domain, &domain_len ) && domain_len && domain[0];
+    trace( "machine DNS domain: %s\n", have_domain ? wine_dbgstr_w(domain) : "<none>" );
+
+    for (i = 0; i < ARRAY_SIZE(fmts); i++)
+    {
+        winetest_push_context( "%u", fmts[i] );
+
+        size = 0;
+        SetLastError( 0xdeadbeef );
+        rc = pGetUserNameExW( fmts[i], NULL, &size );
+
+        if (!have_domain)
+        {
+            /* Not in a domain: only NameSamCompatible has an answer */
+            ok( !rc, "got %d\n", rc );
+            ok( GetLastError() == ERROR_NONE_MAPPED, "got %lu\n", GetLastError() );
+        }
+        else
+        {
+            /* The sizing call reports the required size, the call with that size answers the name */
+            ok( !rc, "got %d\n", rc );
+            ok( GetLastError() == ERROR_MORE_DATA, "got %lu\n", GetLastError() );
+            ok( size > user_len + 1, "got %lu for user %s\n", size, wine_dbgstr_w(user) );
+
+            len = size;
+            rc = pGetUserNameExW( fmts[i], name, &len );
+            ok( rc, "got %lu\n", GetLastError() );
+            if (rc)
+            {
+                ok( len == lstrlenW( name ), "got %lu for %s\n", len, wine_dbgstr_w(name) );
+                if (fmts[i] == NameUserPrincipal)
+                {
+                    ok( name[user_len] == '@', "expected user@domain, got %s\n", wine_dbgstr_w(name) );
+                    ok( !_wcsnicmp( name, user, user_len ), "expected %s to start with %s\n",
+                        wine_dbgstr_w(name), wine_dbgstr_w(user) );
+                    ok( lstrlenW( name ) > user_len + 1, "expected a domain after the '@', got %s\n",
+                        wine_dbgstr_w(name) );
+                }
+                else
+                {
+                    ok( lstrlenW( name ) > user_len + 1, "expected domain\\user, got %s\n", wine_dbgstr_w(name) );
+                    ok( name[lstrlenW(name) - user_len - 1] == '\\', "expected domain\\user, got %s\n",
+                        wine_dbgstr_w(name) );
+                    ok( !_wcsicmp( name + lstrlenW(name) - user_len, user ), "expected %s to end with %s\n",
+                        wine_dbgstr_w(name), wine_dbgstr_w(user) );
+                }
+            }
+
+            size = 1;
+            name[0] = 0xff;
+            SetLastError( 0xdeadbeef );
+            rc = pGetUserNameExW( fmts[i], name, &size );
+            ok( !rc, "got %d\n", rc );
+            ok( GetLastError() == ERROR_MORE_DATA, "got %lu\n", GetLastError() );
+            ok( size > 1, "got %lu\n", size );
+            ok( name[0] == (WCHAR)0xff, "expected unchanged buffer\n" );
+        }
+
+        winetest_pop_context();
+    }
+
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, params_key, 0, KEY_WRITE, &key ))
+    {
+        if (have_old_domain)
+            RegSetValueExW( key, domain_value, 0, REG_SZ, (const BYTE *)old_domain,
+                            (lstrlenW(old_domain) + 1) * sizeof(WCHAR) );
+        else
+            RegDeleteValueW( key, domain_value );
+        RegCloseKey( key );
+    }
+}
