+static void test_RoGetMetaDataFile(void)
+{
+    static const struct
+    {
+        const WCHAR *name;
+        HRESULT      hr;
+        const WCHAR *file;   /* the file the type is described by, NULL when the call fails */
+    }
+    tests[] =
+    {
+        { L"Windows.Storage.StorageFile", S_OK, L"windows.storage.winmd" },
+        { L"Windows.Storage.FileProperties.BasicProperties", S_OK, L"windows.storage.winmd" },
+        { L"Windows.Foundation.Metadata.ApiInformation", S_OK, L"windows.foundation.winmd" },
+        /* a name that is a namespace and not a type, an unknown type, and a name with an empty part
+         * around its last dot */
+        { L"Windows.Storage", RO_E_METADATA_NAME_IS_NAMESPACE, NULL },
+        { L"Windows.Nonexistent.Type", RO_E_METADATA_NAME_NOT_FOUND, NULL },
+        { L"Windows.Storage.", RO_E_METADATA_INVALID_TYPE_FORMAT, NULL },
+        { L".StorageFile", RO_E_METADATA_INVALID_TYPE_FORMAT, NULL },
+    };
+    IMetaDataImport2 *import;
+    HSTRING name, path;
+    mdTypeDef token;
+    HRESULT hr;
+    DWORD i;
+
+    hr = RoInitialize(RO_INIT_MULTITHREADED);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    if (!have_metadata_dir())
+    {
+        skip( "no WinRT metadata files installed, skipping the resolution tests\n" );
+        RoUninitialize();
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context("%lu: ", i);
+
+        hr = WindowsCreateString( tests[i].name, wcslen(tests[i].name), &name );
+        ok(hr == S_OK, "got %#lx\n", hr);
+
+        path = NULL;
+        token = 0;
+        hr = RoGetMetaDataFile( name, NULL, &path, NULL, &token );
+        ok(hr == tests[i].hr, "RoGetMetaDataFile(%s) got %#lx\n", wine_dbgstr_w(tests[i].name), hr);
+        if (hr == S_OK && tests[i].file)
+        {
+            const WCHAR *str = WindowsGetStringRawBuffer( path, NULL );
+            const WCHAR *base = str + lstrlenW( str );
+
+            while (base > str && base[-1] != '\\') base--;
+            ok(token != mdTypeDefNil, "got %#x\n", token);
+            ok(!wcsicmp( base, tests[i].file ), "got %s, expected a %s file\n",
+               wine_dbgstr_w(str), wine_dbgstr_w(tests[i].file) );
+        }
+
+        if (path) WindowsDeleteString( path );
+        WindowsDeleteString( name );
+        winetest_pop_context();
+    }
+
+    /* The metadata reader is only handed back when the dispenser has IMetaDataImport2: Wine's
+     * rometadata.dll does not implement it yet, so the call answers E_NOINTERFACE there and resets its
+     * outputs, as the API contract requires. */
+    hr = WindowsCreateString( L"Windows.Storage.StorageFile", wcslen(L"Windows.Storage.StorageFile"), &name );
+    ok(hr == S_OK, "got %#lx\n", hr);
+    path = NULL;
+    import = NULL;
+    token = 0;
+    hr = RoGetMetaDataFile( name, NULL, &path, &import, &token );
+    todo_wine ok(hr == S_OK, "got %#lx\n", hr);
+    if (hr == S_OK)
+    {
+        ok(import != NULL, "expected a metadata reader\n");
+        ok(token != mdTypeDefNil, "got %#x\n", token);
+        IUnknown_Release( (IUnknown *)import );
+    }
+    WindowsDeleteString( name );
+
+    RoUninitialize();
+}
