+static HRESULT dcomp_device_query_interface(struct dcomp_device *device, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDCompositionDevice))
+        *out = &device->IDCompositionDevice_iface;
+    else if (IsEqualGUID(iid, &IID_IDCompositionDevice2) || IsEqualGUID(iid, &IID_IDCompositionDevice3))
+        *out = &device->IDCompositionDevice3_iface;
+    else if (IsEqualGUID(iid, &IID_IDCompositionDesktopDevice))
+        *out = &device->IDCompositionDesktopDevice_iface;
+    else
+    {
+        WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+
+    dcomp_device_addref(device);
+    return S_OK;
+}
+
+static ULONG dcomp_device_addref(struct dcomp_device *device)
+{
+    ULONG refcount = InterlockedIncrement(&device->ref);
+
+    TRACE("%p, refcount %lu.\n", device, refcount);
+
+    return refcount;
+}
+
+struct dcomp_target *dcomp_device_get_target(struct dcomp_device *device, HWND hwnd)
+{
+    struct dcomp_target *target;
+
+    LIST_FOR_EACH_ENTRY(target, &device->targets, struct dcomp_target, entry)
+    {
+        if (target->hwnd == hwnd)
+            return target;
+    }
+    return NULL;
+}
+
+static ULONG dcomp_device_release(struct dcomp_device *device)
+{
+    ULONG refcount = InterlockedDecrement(&device->ref);
+
+    TRACE("%p, refcount %lu.\n", device, refcount);
+
+    if (!refcount)
+    {
+        struct dcomp_target *target, *next;
+
+        LIST_FOR_EACH_ENTRY_SAFE(target, next, &device->targets, struct dcomp_target, entry)
+        {
+            list_remove(&target->entry);
+            IDCompositionTarget_Release(&target->iface);
+        }
+        if (device->rendering_device) IUnknown_Release(device->rendering_device);
+        free(device);
+    }
+
+    return refcount;
+}
+
+static HRESULT dcomp_device_commit(struct dcomp_device *device)
+{
+    struct dcomp_target *target;
+
+    LIST_FOR_EACH_ENTRY(target, &device->targets, struct dcomp_target, entry)
+        dcomp_target_present(target);
+
+    return S_OK;
+}
