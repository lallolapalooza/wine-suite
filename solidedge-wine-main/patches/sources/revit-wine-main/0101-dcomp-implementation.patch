+static ULONG STDMETHODCALLTYPE dcomp_visual_Release(IDCompositionVisual2 *iface)
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual2(iface);
+    ULONG refcount = InterlockedDecrement(&visual->ref);
+
+    TRACE("%p, refcount %lu.\n", visual, refcount);
+
+    if (!refcount)
+    {
+        struct dcomp_visual_child *child, *next;
+
+        LIST_FOR_EACH_ENTRY_SAFE(child, next, &visual->children, struct dcomp_visual_child, entry)
+        {
+            list_remove(&child->entry);
+            IDCompositionVisual_Release(child->visual);
+            free(child);
+        }
+        if (visual->content) IUnknown_Release(visual->content);
+        free(visual);
+    }
+
+    return refcount;
+}
