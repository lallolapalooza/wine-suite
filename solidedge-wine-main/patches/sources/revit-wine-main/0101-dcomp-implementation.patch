+static void test_device_creation(void)
+{
+    IDCompositionDesktopDevice *desktop_device;
+    IDCompositionDevice3 *device3;
+    IDCompositionDevice2 *device2;
+    IDCompositionTarget *target;
+    IDCompositionVisual2 *visual2;
+    IDCompositionVisual3 *visual3;
+    IDCompositionVisual *visual;
+    IDCompositionDevice *device;
+    IUnknown *unknown;
+    HWND hwnd;
+    HRESULT hr;
+
+    if (!pDCompositionCreateDevice2)
+    {
+        win_skip("DCompositionCreateDevice2 is not available.\n");
+        return;
+    }
+
+    hwnd = create_test_window();
+    ok(!!hwnd, "Failed to create a test window, error %lu.\n", GetLastError());
+
+    hr = pDCompositionCreateDevice2(NULL, &IID_IDCompositionDevice, (void **)&device);
+    ok(hr == S_OK, "DCompositionCreateDevice2 returned %#lx.\n", hr);
+    if (FAILED(hr))
+    {
+        DestroyWindow(hwnd);
+        return;
+    }
+
+    hr = IDCompositionDevice_QueryInterface(device, &IID_IDCompositionDevice2, (void **)&device2);
+    ok(hr == S_OK, "QueryInterface(IDCompositionDevice2) returned %#lx.\n", hr);
+
+    hr = IDCompositionDevice_QueryInterface(device, &IID_IDCompositionDevice3, (void **)&device3);
+    ok(hr == S_OK, "QueryInterface(IDCompositionDevice3) returned %#lx.\n", hr);
+
+    hr = IDCompositionDevice_QueryInterface(device, &IID_IDCompositionDesktopDevice, (void **)&desktop_device);
+    ok(hr == S_OK, "QueryInterface(IDCompositionDesktopDevice) returned %#lx.\n", hr);
+
+    hr = IDCompositionDevice_QueryInterface(device, &IID_IDCompositionDevice, (void **)&unknown);
+    ok(hr == S_OK, "QueryInterface(IDCompositionDevice) returned %#lx.\n", hr);
+    if (SUCCEEDED(hr)) IUnknown_Release(unknown);
+
+    if (SUCCEEDED(hr))
+    {
+        hr = IDCompositionDesktopDevice_CreateTargetForHwnd(desktop_device, hwnd, TRUE, &target);
+        ok(hr == S_OK, "CreateTargetForHwnd returned %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IDCompositionDevice2_CreateVisual(device2, &visual2);
+            ok(hr == S_OK, "CreateVisual returned %#lx.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IDCompositionVisual2_QueryInterface(visual2, &IID_IDCompositionVisual, (void **)&visual);
+                ok(hr == S_OK, "QueryInterface(IDCompositionVisual) returned %#lx.\n", hr);
+                if (SUCCEEDED(hr)) IDCompositionVisual_Release(visual);
+
+                hr = IDCompositionVisual2_QueryInterface(visual2, &IID_IDCompositionVisual2, (void **)&visual2);
+                ok(hr == S_OK, "QueryInterface(IDCompositionVisual2) returned %#lx.\n", hr);
+
+                hr = IDCompositionVisual2_QueryInterface(visual2, &IID_IDCompositionVisual3, (void **)&visual3);
+                ok(hr == S_OK, "QueryInterface(IDCompositionVisual3) returned %#lx.\n", hr);
+                if (SUCCEEDED(hr))
+                    visual3->lpVtbl->base.Release((IDCompositionVisual2 *)visual3);
