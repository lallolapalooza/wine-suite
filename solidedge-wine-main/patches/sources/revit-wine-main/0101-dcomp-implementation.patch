## 0101-dcomp-first-implementation.patch  (subject: dcomp: implement the device/target/visual objects and Commit)

SYMPTOM
  Autodesk's licensing dialog (and every WebView2 window) stays blank/white under Wine. `dcomp.dll` in this tree
  was three stubs — `DCompositionCreateDevice{,2,3}` returning `E_NOTIMPL` and no visual/target/surface objects —
  while both the Autodesk licensing host (`browser_native.dll`) and the WebView2 runtime (`msedge.dll` 143) drive
  DirectComposition unconditionally: `DCompositionCreateDevice(NULL, &IID_IDCompositionDevice)` →
  `CreateTargetForHwnd(hwnd, topmost=FALSE|TRUE)` → `CreateVisual`/`AddVisual` → `SetRoot` → `SetContent` → `Commit`.
  Chromium switches do not avoid the path (five sets tried, incl. `--disable-gpu` and `--disable-direct-composition`
  — window black every time).

WINDOWS BEHAVIOUR RESTORED
  A DComp device hands out targets (per HWND), visuals (a tree, with content) and, on `Commit`, the tree becomes
  visible in the target window — for a `topmost=TRUE` target composited above the window's own content. This
  implementation provides the device (`IDCompositionDevice`/`2`/`3`, desktop device as separate subobjects), target
  and visual objects with a child list and content lookup, `QueryInterface` for `IDCompositionVisual2/3` (Chromium's
  `CheckedCastToVisual3()` is a `CHECK_EQ(hr, S_OK)` and kills the GPU process otherwise), and `Commit`, which
  composites the root visual's content into the target HWND, honouring offset/clip and premultiplied alpha.
  `CreateSurface`/`BeginDraw` and the effect/transform factories remain `E_NOTIMPL` (never requested on these paths;
  Chromium logs and falls back).

TEST
  `dlls/dcomp/tests/dcomp.c` — device→target→visual→`SetRoot`→`Commit` paints the test's own window; QIs for
  `IDCompositionVisual2/3`, `IDCompositionDevice2/3`, `IDCompositionDesktopDevice`. Run:
  `tools/run_wine_tests.sh dcomp` (needs `configure` regenerated once — autoconf is not installed here; the suite was
  verified by building it out-of-tree against `libdcomp.a`: 24 tests, 0 failures).
diff -ruN a/dlls/dcomp/dcomp_private.h
--- a/dlls/dcomp/dcomp_private.h	1969-12-31 19:00:00.000000000 -0500
+++ b/dlls/dcomp/dcomp_private.h	2026-09-27 21:01:30.249751767 -0500
@@ -0,0 +1,96 @@
+#ifndef __DCOMP_PRIVATE_H
+#define __DCOMP_PRIVATE_H
+
+#include "dcomp.h"
+#include "wine/list.h"
+
+struct dcomp_device
+{
+    IDCompositionDevice IDCompositionDevice_iface;
+    IDCompositionDevice3 IDCompositionDevice3_iface;
+    IDCompositionDesktopDevice IDCompositionDesktopDevice_iface;
+    LONG ref;
+    IUnknown *rendering_device;
+    struct list targets;
+};
+
+struct dcomp_target
+{
+    IDCompositionTarget iface;
+    LONG ref;
+    struct dcomp_device *device;
+    HWND hwnd;
+    BOOL topmost;
+    IDCompositionVisual *root;
+    struct list entry;
+};
+
+struct dcomp_visual_child
+{
+    struct list entry;
+    IDCompositionVisual *visual;
+};
+
+struct dcomp_visual
+{
+    IDCompositionVisual2 iface;
+    LONG ref;
+    IUnknown *content;
+    float offset_x;
+    float offset_y;
+    struct list children;
+};
+
+/* IDCompositionVisual3 is not declared by this tree's dcomp.h. Its vtable is the
+ * IDCompositionVisual2 vtable followed by the IDCompositionVisualDebug and
+ * IDCompositionVisual3 methods, so a single table covers all three identifiers. */
+typedef struct dcomp_visual3 IDCompositionVisual3;
+
+struct dcomp_visual3
+{
+    const struct dcomp_visual3_vtbl *lpVtbl;
+};
+
+typedef struct dcomp_visual3_vtbl
+{
+    IDCompositionVisual2Vtbl base;
+    /* IDCompositionVisualDebug */
+    HRESULT (STDMETHODCALLTYPE *EnableHeatMap)(IDCompositionVisual3 *iface, const D2D1_COLOR_F *color);
+    HRESULT (STDMETHODCALLTYPE *DisableHeatMap)(IDCompositionVisual3 *iface);
+    HRESULT (STDMETHODCALLTYPE *EnableRedrawRegions)(IDCompositionVisual3 *iface);
+    HRESULT (STDMETHODCALLTYPE *DisableRedrawRegions)(IDCompositionVisual3 *iface);
+    /* IDCompositionVisual3 */
+    HRESULT (STDMETHODCALLTYPE *SetDepthMode)(IDCompositionVisual3 *iface, enum DCOMPOSITION_DEPTH_MODE mode);
+    HRESULT (STDMETHODCALLTYPE *SetOffsetZAnimation)(IDCompositionVisual3 *iface, IDCompositionAnimation *animation);
+    HRESULT (STDMETHODCALLTYPE *SetOffsetZ)(IDCompositionVisual3 *iface, float offset_z);
+    HRESULT (STDMETHODCALLTYPE *SetOpacityAnimation)(IDCompositionVisual3 *iface, IDCompositionAnimation *animation);
+    HRESULT (STDMETHODCALLTYPE *SetOpacity)(IDCompositionVisual3 *iface, float opacity);
+    HRESULT (STDMETHODCALLTYPE *SetTransform3D)(IDCompositionVisual3 *iface, IDCompositionTransform3D *transform);
+    HRESULT (STDMETHODCALLTYPE *SetTransformMatrix)(IDCompositionVisual3 *iface, const D2D_MATRIX_4X4_F *matrix);
+    HRESULT (STDMETHODCALLTYPE *SetVisible)(IDCompositionVisual3 *iface, BOOL visible);
+} dcomp_visual3_vtbl;
+
+DEFINE_GUID(IID_IDCompositionVisual3, 0x2775f462, 0xb6c1, 0x4015, 0xb0,0xbe,0xb3,0xe7,0xd6,0xa4,0x97,0x6d);
+
+static inline struct dcomp_device *impl_from_IDCompositionDevice(IDCompositionDevice *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_device, IDCompositionDevice_iface);
+}
+
+static inline struct dcomp_device *impl_from_IDCompositionDevice3(IDCompositionDevice3 *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_device, IDCompositionDevice3_iface);
+}
+
+static inline struct dcomp_device *impl_from_IDCompositionDesktopDevice(IDCompositionDesktopDevice *iface)
+{
+    return CONTAINING_RECORD(iface, struct dcomp_device, IDCompositionDesktopDevice_iface);
+}
+
+HRESULT dcomp_target_create(struct dcomp_device *device, HWND hwnd, BOOL topmost,
+        struct dcomp_target **target);
+void dcomp_target_present(struct dcomp_target *target);
+HRESULT dcomp_visual_create(struct dcomp_visual **visual);
+IUnknown *dcomp_visual_find_content(IDCompositionVisual *visual, float *offset_x, float *offset_y);
+
+#endif /* __DCOMP_PRIVATE_H */
