+static HRESULT dcomp_device_create(IUnknown *rendering_device, REFIID iid, void **out)
+{
+    struct dcomp_device *device;
+
+    TRACE("rendering_device %p, iid %s, out %p.\n", rendering_device, debugstr_guid(iid), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+
+    if (!IsEqualGUID(iid, &IID_IUnknown) && !IsEqualGUID(iid, &IID_IDCompositionDevice)
+            && !IsEqualGUID(iid, &IID_IDCompositionDevice2) && !IsEqualGUID(iid, &IID_IDCompositionDevice3)
+            && !IsEqualGUID(iid, &IID_IDCompositionDesktopDevice))
+    {
+        WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+
+    if (!(device = calloc(1, sizeof(*device))))
+        return E_OUTOFMEMORY;
+
+    device->IDCompositionDevice_iface.lpVtbl = &dcomp_device1;
+    device->IDCompositionDevice3_iface.lpVtbl = &dcomp_device3;
+    device->IDCompositionDesktopDevice_iface.lpVtbl = &dcomp_device_desktop;
+    device->ref = 1;
+    list_init(&device->targets);
+    if (rendering_device)
+    {
+        device->rendering_device = rendering_device;
+        IUnknown_AddRef(rendering_device);
+    }
+
+    return dcomp_device_query_interface(device, iid, out);
+}
