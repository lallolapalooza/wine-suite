+/* Wine's dxgi exposes this privately so that a compositor can tell a
+ * composition swapchain where to show its frames. */
+typedef void (CDECL *set_composition_target_fn)(IDXGISwapChain *swapchain, HWND window, int x, int y);
+
+static set_composition_target_fn get_set_composition_target(void)
+{
+    static set_composition_target_fn fn;
+    static BOOL looked_up;
+    HMODULE module;
+
+    if (!looked_up)
+    {
+        looked_up = TRUE;
+        if ((module = GetModuleHandleW(L"dxgi.dll")))
+            fn = (set_composition_target_fn)GetProcAddress(module, "__wine_dxgi_set_composition_target");
+        if (!fn)
+            WARN("dxgi does not support composition targets.\n");
+    }
+    return fn;
+}
