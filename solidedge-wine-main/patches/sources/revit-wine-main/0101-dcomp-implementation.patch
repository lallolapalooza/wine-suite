+                hr = IDCompositionTarget_SetRoot(target, (IDCompositionVisual *)visual2);
+                ok(hr == S_OK, "SetRoot returned %#lx.\n", hr);
+
+                hr = IDCompositionVisual2_SetOffsetX(visual2, 0.0f);
+                ok(hr == S_OK, "SetOffsetX returned %#lx.\n", hr);
+                hr = IDCompositionVisual2_SetOffsetY(visual2, 0.0f);
+                ok(hr == S_OK, "SetOffsetY returned %#lx.\n", hr);
