+
+/* A commit of a target that has a root visual but no content must not paint
+ * anything: another process (Chromium's GPU process) may own the window's
+ * content and must not be overwritten. End-to-end presentation through a
+ * composition swapchain is covered by the WebView2 harness. */
+static void test_commit_without_content(void)
+{
+    IDCompositionDesktopDevice *desktop_device;
+    IDCompositionTarget *target;
+    IDCompositionVisual2 *visual;
+    IDCompositionDevice *device;
+    COLORREF colour;
+    HDC dc;
+    HWND hwnd;
+    HRESULT hr;
+
+    if (!pDCompositionCreateDevice2)
+    {
+        win_skip("DCompositionCreateDevice2 is not available.\n");
+        return;
+    }
+
+    hwnd = create_test_window();
+    ok(!!hwnd, "Failed to create a test window, error %lu.\n", GetLastError());
+
+    hr = pDCompositionCreateDevice2(NULL, &IID_IDCompositionDevice, (void **)&device);
+    ok(hr == S_OK, "DCompositionCreateDevice2 returned %#lx.\n", hr);
+    if (FAILED(hr))
+    {
+        DestroyWindow(hwnd);
+        return;
+    }
+
+    hr = IDCompositionDevice_QueryInterface(device, &IID_IDCompositionDesktopDevice, (void **)&desktop_device);
+    ok(hr == S_OK, "QueryInterface(IDCompositionDesktopDevice) returned %#lx.\n", hr);
+    if (FAILED(hr))
+    {
+        IDCompositionDevice_Release(device);
+        DestroyWindow(hwnd);
+        return;
+    }
+
+    hr = IDCompositionDesktopDevice_CreateTargetForHwnd(desktop_device, hwnd, TRUE, &target);
+    ok(hr == S_OK, "CreateTargetForHwnd returned %#lx.\n", hr);
+    hr = IDCompositionDesktopDevice_CreateVisual(desktop_device, &visual);
+    ok(hr == S_OK, "CreateVisual returned %#lx.\n", hr);
+    hr = IDCompositionTarget_SetRoot(target, (IDCompositionVisual *)visual);
+    ok(hr == S_OK, "SetRoot returned %#lx.\n", hr);
+
+    dc = GetDC(hwnd);
+    if (dc)
+    {
+        RECT rect;
+
+        GetClientRect(hwnd, &rect);
+        PatBlt(dc, 0, 0, rect.right, rect.bottom, BLACKNESS);
+        GdiFlush();
+        colour = GetPixel(dc, 10, 10);
+
+        hr = IDCompositionDevice_Commit(device);
+        ok(hr == S_OK, "Commit returned %#lx.\n", hr);
+        GdiFlush();
+
+        ok(GetPixel(dc, 10, 10) == colour, "Commit without content changed the target window.\n");
+        ReleaseDC(hwnd, dc);
+    }
+
+    IDCompositionVisual2_Release(visual);
+    IDCompositionTarget_Release(target);
+    IDCompositionDesktopDevice_Release(desktop_device);
+    IDCompositionDevice_Release(device);
+    DestroyWindow(hwnd);
+}
+
+START_TEST(dcomp)
+{
+    HMODULE module = LoadLibraryA("dcomp.dll");
+
+    ok(!!module, "Failed to load dcomp.dll.\n");
+    if (module)
+    {
+        pDCompositionCreateDevice = (void *)GetProcAddress(module, "DCompositionCreateDevice");
+        pDCompositionCreateDevice2 = (void *)GetProcAddress(module, "DCompositionCreateDevice2");
+        pDCompositionCreateDevice3 = (void *)GetProcAddress(module, "DCompositionCreateDevice3");
+    }
+
+    test_device_creation();
+    test_commit_without_content();
+}
