+HRESULT dcomp_visual_create(struct dcomp_visual **out)
+{
+    struct dcomp_visual *visual;
+
+    if (!(visual = calloc(1, sizeof(*visual))))
+        return E_OUTOFMEMORY;
+
+    visual->iface.lpVtbl = &dcomp_visual.base;
+    visual->ref = 1;
+    list_init(&visual->children);
+
+    TRACE("Created visual %p.\n", visual);
+
+    *out = visual;
+    return S_OK;
+}
+
+/* Depth first search for the first visual that has content. Only visuals created
+ * by this module are inspected; visuals from other implementations are opaque. */
+IUnknown *dcomp_visual_find_content(IDCompositionVisual *visual, float *offset_x, float *offset_y)
+{
+    struct dcomp_visual_child *child, *next;
+    struct dcomp_visual *object;
+    IUnknown *content;
+
+    if (!visual || visual->lpVtbl != (IDCompositionVisualVtbl *)&dcomp_visual.base)
+        return NULL;
+
+    object = impl_from_IDCompositionVisual2((IDCompositionVisual2 *)visual);
+
+    if (object->content)
+    {
+        *offset_x = object->offset_x;
+        *offset_y = object->offset_y;
+        IUnknown_AddRef(object->content);
+        return object->content;
+    }
+
+    LIST_FOR_EACH_ENTRY_SAFE(child, next, &object->children, struct dcomp_visual_child, entry)
+    {
+        if ((content = dcomp_visual_find_content(child->visual, offset_x, offset_y)))
+            return content;
+    }
+    return NULL;
+}
