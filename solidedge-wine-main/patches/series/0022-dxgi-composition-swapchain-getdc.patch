+void d3d11_swapchain_set_hidden_window(IDXGISwapChain1 *swapchain_iface, HWND window)
+{
+    struct d3d11_swapchain *swapchain;
+
+    if (!swapchain_iface)
+        return;
+
+    swapchain = d3d11_swapchain_from_IDXGISwapChain4((IDXGISwapChain4 *)swapchain_iface);
+    swapchain->hidden_window = window;
+}
+
+static HRESULT STDMETHODCALLTYPE d3d11_swapchain_GetBuffer(IDXGISwapChain4 *iface,
+        UINT buffer_idx, REFIID riid, void **surface);
+
+void __wine_dxgi_set_composition_target(IDXGISwapChain *swapchain_iface, HWND window, int x, int y)
+{
+    struct d3d11_swapchain *swapchain;
+
+    if (!swapchain_iface)
+        return;
+
+    swapchain = d3d11_swapchain_from_IDXGISwapChain4((IDXGISwapChain4 *)swapchain_iface);
+    swapchain->composition_window = window;
+    swapchain->composition_x = x;
+    swapchain->composition_y = y;
+
+    TRACE("Swapchain %p now composites into window %p at %d,%d.\n", swapchain, window, x, y);
+}
+
+/* Blit the buffer the application has just rendered into (buffer 0, which is
+ * what the compositor is expected to show) into the target window. */
+static void d3d11_swapchain_composite(struct d3d11_swapchain *swapchain)
+{
+    DXGI_SURFACE_DESC surface_desc;
+    IDXGISurface1 *surface;
+    HDC src_dc, dst_dc;
+    HRESULT hr;
+
+    if (!swapchain->composition_window)
+        return;
+
+    TRACE("Compositing swapchain %p into window %p.\n", swapchain, swapchain->composition_window);
+
+    if (FAILED(hr = d3d11_swapchain_GetBuffer(&swapchain->IDXGISwapChain4_iface, 0,
+            &IID_IDXGISurface1, (void **)&surface)))
+    {
+        WARN("Failed to get buffer for compositing, hr %#lx.\n", hr);
+        return;
+    }
+
+    if (FAILED(hr = IDXGISurface1_GetDesc(surface, &surface_desc)))
+        WARN("Failed to get the composition buffer description, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr) && FAILED(hr = IDXGISurface1_GetDC(surface, FALSE, &src_dc)))
+        WARN("Failed to get a DC for the composition buffer, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        if ((dst_dc = GetDC(swapchain->composition_window)))
+        {
+            TRACE("Blitting %ux%u buffer to window %p at %d,%d, centre pixel %06lx.\n",
+                    surface_desc.Width, surface_desc.Height, swapchain->composition_window,
+                    swapchain->composition_x, swapchain->composition_y,
+                    (unsigned long)GetPixel(src_dc, surface_desc.Width / 2, surface_desc.Height / 2));
+            StretchBlt(dst_dc, swapchain->composition_x, swapchain->composition_y,
+                    surface_desc.Width, surface_desc.Height,
+                    src_dc, 0, 0, surface_desc.Width, surface_desc.Height, SRCCOPY);
+            GdiFlush();
+            ReleaseDC(swapchain->composition_window, dst_dc);
+        }
+        IDXGISurface1_ReleaseDC(surface, NULL);
+    }
+    IDXGISurface1_Release(surface);
+}
