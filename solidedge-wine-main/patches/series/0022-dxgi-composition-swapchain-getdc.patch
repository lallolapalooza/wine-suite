 static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForComposition(IWineDXGIFactory *iface,
         IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
-    FIXME("iface %p, device %p, desc %p, output %p, swapchain %p stub!\n",
+    DXGI_SWAP_CHAIN_FULLSCREEN_DESC fullscreen_desc = {0};
+    IWineDXGISwapChainFactory *swapchain_factory;
+    DXGI_SWAP_CHAIN_DESC1 hidden_desc;
+    HWND window;
+    HRESULT hr;
+
+    TRACE("iface %p, device %p, desc %p, output %p, swapchain %p.\n",
             iface, device, desc, output, swapchain);
 
-    return E_NOTIMPL;
+    if (!device || !desc || !swapchain)
+    {
+        WARN("Invalid pointer.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    if (!dxgi_validate_swapchain_desc(desc))
+        return DXGI_ERROR_INVALID_CALL;
+
+    if (output)
+        FIXME("Ignoring output %p.\n", output);
+
+    if (FAILED(hr = IUnknown_QueryInterface(device, &IID_IWineDXGISwapChainFactory, (void **)&swapchain_factory)))
+    {
+        ERR("This is not the device we're looking for.\n");
+        return DXGI_ERROR_UNSUPPORTED;
+    }
+
+    /* A composition swapchain has no application window. Create a hidden one so
+     * that the swapchain can be created through the regular wined3d path; its
+     * contents are presented by the compositor, not blitted by wined3d. */
+    hidden_desc = *desc;
+    if (!hidden_desc.Width)
+        hidden_desc.Width = 8;
+    if (!hidden_desc.Height)
+        hidden_desc.Height = 8;
+    /* The compositor reads the back buffer through IDXGISurface1::GetDC. */
+    hidden_desc.Flags |= DXGI_SWAP_CHAIN_FLAG_GDI_COMPATIBLE;
+    if (!(window = CreateWindowExW(0, L"Static", NULL, WS_POPUP, 0, 0, hidden_desc.Width,
+            hidden_desc.Height, NULL, NULL, NULL, NULL)))
+    {
+        WARN("Failed to create hidden window, error %lu.\n", GetLastError());
+        IWineDXGISwapChainFactory_Release(swapchain_factory);
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    fullscreen_desc.Windowed = TRUE;
+
+    hr = IWineDXGISwapChainFactory_create_swapchain(swapchain_factory, (IDXGIFactory *)iface,
+            window, &hidden_desc, &fullscreen_desc, output, swapchain);
+    IWineDXGISwapChainFactory_Release(swapchain_factory);
+
+    if (FAILED(hr))
+    {
+        WARN("Failed to create swapchain, hr %#lx.\n", hr);
+        DestroyWindow(window);
+        return hr;
+    }
+
+    d3d11_swapchain_set_hidden_window(*swapchain, window);
+
+    TRACE("Created composition swapchain %p with hidden window %p.\n", *swapchain, window);
+    return S_OK;
 }
 
