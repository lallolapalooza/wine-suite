+/* Windows always has the group-policy and enterprise certificate store keys,
+ * including the ROOT store, so CertOpenStore with
+ * CERT_STORE_OPEN_EXISTING_FLAG succeeds for them.  Wine only mapped the
+ * group-policy locations to their registry paths (opening a store whose key
+ * was not there yet failed with ERROR_FILE_NOT_FOUND) and returned NULL for
+ * CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE altogether.  The tests also add a
+ * certificate through the store API and read it back, to check the location
+ * maps to the registry path that is actually read and written.
+ */
+static const struct
+{
+    LPCSTR prov;
+    HKEY root;
+    DWORD location;
+    LPCWSTR base_path;
+} system_reg_store_locations[] =
+{
+    { CERT_STORE_PROV_SYSTEM_REGISTRY, HKEY_CURRENT_USER,
+        CERT_SYSTEM_STORE_CURRENT_USER_GROUP_POLICY,
+        CERT_GROUP_POLICY_SYSTEM_STORE_REGPATH },
+    { CERT_STORE_PROV_SYSTEM_REGISTRY, HKEY_LOCAL_MACHINE,
+        CERT_SYSTEM_STORE_LOCAL_MACHINE_GROUP_POLICY,
+        CERT_GROUP_POLICY_SYSTEM_STORE_REGPATH },
+    { CERT_STORE_PROV_SYSTEM_REGISTRY, HKEY_LOCAL_MACHINE,
+        CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE,
+        L"Software\\Microsoft\\EnterpriseCertificates" },
+    /* The generic system store provider wraps the registry store in a
+     * collection and uses the same location mapping. */
+    { CERT_STORE_PROV_SYSTEM, HKEY_LOCAL_MACHINE,
+        CERT_SYSTEM_STORE_LOCAL_MACHINE_ENTERPRISE,
+        L"Software\\Microsoft\\EnterpriseCertificates" },
+};
+
+static void testSystemRegStoreLocations(void)
+{
+    static const WCHAR store_name[] = L"ROOT";
+    WCHAR store_path[MAX_PATH], subkey_path[MAX_PATH];
+    HCERTSTORE store;
+    unsigned int i;
+
+    /* Not all OSes support CERT_STORE_PROV_SYSTEM_REGISTRY, so don't continue
+     * testing if they don't.
+     */
+    store = CertOpenStore(CERT_STORE_PROV_SYSTEM_REGISTRY, 0, 0,
+     CERT_SYSTEM_STORE_CURRENT_USER | CERT_STORE_OPEN_EXISTING_FLAG, L"My");
+    if (!store)
+    {
+        skip("CERT_STORE_PROV_SYSTEM_REGISTRY is not available\n");
+        return;
+    }
+    CertCloseStore(store, 0);
+
+    for (i = 0; i < ARRAY_SIZE(system_reg_store_locations); i++)
+    {
+        HKEY root = system_reg_store_locations[i].root, key;
+        DWORD location = system_reg_store_locations[i].location;
+        LPCWSTR base = system_reg_store_locations[i].base_path;
+        PCCERT_CONTEXT cert = NULL, found;
+        BOOL existed, added = FALSE;
+        BOOL ret;
+
+        wsprintfW(store_path, L"%s\\%s", base, store_name);
+        /* Windows has these stores, so only remove a key this test created
+         * itself.  An unfixed Wine does not create the key either, so the
+         * OPEN_EXISTING open below fails there. */
+        existed = !RegOpenKeyExW(root, store_path, 0, KEY_READ, &key);
+        if (existed)
+            RegCloseKey(key);
+
+        /* Windows always has these store keys, so OPEN_EXISTING succeeds. */
+        store = CertOpenStore(system_reg_store_locations[i].prov, 0, 0,
+         location | CERT_STORE_OPEN_EXISTING_FLAG, store_name);
+        ok(store != NULL, "%08lx: CertOpenStore failed: %08lx\n",
+         location, GetLastError());
+        if (!store)
+            continue;
+
+        cert = CertCreateCertificateContext(X509_ASN_ENCODING, bigCert,
+         sizeof(bigCert));
+        ok(cert != NULL, "%08lx: CertCreateCertificateContext failed: %08lx\n",
+         location, GetLastError());
+        if (cert)
+        {
+            ret = CertAddCertificateContextToStore(store, cert,
+             CERT_STORE_ADD_ALWAYS, NULL);
+            if (!ret && GetLastError() == ERROR_ACCESS_DENIED)
+                skip("%08lx: no access to the store\n", location);
+            else
+            {
+                ok(ret, "%08lx: adding a certificate failed: %08lx\n",
+                 location, GetLastError());
+                added = ret;
+            }
+        }
+        CertCloseStore(store, 0);
+
+        if (added)
+        {
+            /* The certificate must be readable again through the public API,
+             * from the registry location the location maps to. */
+            store = CertOpenStore(system_reg_store_locations[i].prov, 0, 0,
+             location | CERT_STORE_OPEN_EXISTING_FLAG, store_name);
+            ok(store != NULL, "%08lx: reopening the store failed: %08lx\n",
+             location, GetLastError());
+            if (store)
+            {
+                found = CertFindCertificateInStore(store, X509_ASN_ENCODING, 0,
+                 CERT_FIND_EXISTING, cert, NULL);
+                ok(found != NULL, "%08lx: the certificate was not saved\n",
+                 location);
+                if (found)
+                {
+                    /* Removes the registry value the test set up. */
+                    ret = CertDeleteCertificateFromStore(found);
+                    ok(ret, "%08lx: deleting the certificate failed: %08lx\n",
+                     location, GetLastError());
+                }
+                CertCloseStore(store, 0);
+            }
+        }
+        if (cert)
+            CertFreeCertificateContext(cert);
+
+        /* Opening the store also created the Certificates/CRLs/CTLs subkeys.
+         * Remove those and the store key the test created; RegDeleteTreeW
+         * isn't available on every Wine/Windows version. */
+        if (!existed)
+        {
+            wsprintfW(subkey_path, L"%s\\%s\\Certificates", base, store_name);
+            RegDeleteKeyW(root, subkey_path);
+            wsprintfW(subkey_path, L"%s\\%s\\CRLs", base, store_name);
+            RegDeleteKeyW(root, subkey_path);
+            wsprintfW(subkey_path, L"%s\\%s\\CTLs", base, store_name);
+            RegDeleteKeyW(root, subkey_path);
+            ret = RegDeleteKeyW(root, store_path);
+            ok(!ret, "%08lx: removing the test store failed: %08lx\n",
+             location, GetLastError());
+        }
+    }
+}
