+    if(!pCoInternetCreateSecurityManager) {
+        win_skip("CoInternetCreateSecurityManager not available\n");
+        return;
+    }
+
+    trace("Testing res: URL zones...\n");
+
+    hres = pCoInternetCreateSecurityManager(NULL, &secmgr, 0);
+    ok(hres == S_OK, "CoInternetCreateSecurityManager failed: %08lx\n", hres);
+    if(FAILED(hres))
+        return;
+
+    /* Windows doesn't treat "res:" as a hierarchical scheme, so a res: URL
+     * with an empty host falls through to the ProtocolDefaults lookup and ends
+     * up in the Internet zone instead of URLZONE_INVALID. Before the AutoCAD
+     * 2027 patch Wine applied its empty-host rule to URL_SCHEME_RES and
+     * returned URLZONE_INVALID (0xffffffff) for the URL below. */
