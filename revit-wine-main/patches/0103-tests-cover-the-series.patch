+static void test_iocp_non_overlapped(void)
+{
+    char temp_path[MAX_PATH], file_name[MAX_PATH];
+    char buffer[16], read_buffer[16];
+    OVERLAPPED *povl;
+    ULONG_PTR key;
+    DWORD written, read, count;
+    HANDLE hfile, port;
+    BOOL ret;
+
+    ret = GetTempPathA( MAX_PATH, temp_path );
+    ok( ret && ret < MAX_PATH, "GetTempPathA failed, error %lu\n", GetLastError() );
+    ret = GetTempFileNameA( temp_path, "ioc", 0, file_name );
+    ok( ret, "GetTempFileNameA failed, error %lu\n", GetLastError() );
+
+    memset( buffer, 0x5a, sizeof(buffer) );
+
+    /* deliberately not opened with FILE_FLAG_OVERLAPPED; the flag only matters for
+       whether the I/O itself can be asynchronous */
+    hfile = CreateFileA( file_name, GENERIC_READ | GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                         FILE_ATTRIBUTE_NORMAL, NULL );
+    ok( hfile != INVALID_HANDLE_VALUE, "CreateFileA failed, error %lu\n", GetLastError() );
+    if (hfile == INVALID_HANDLE_VALUE) return;
+
+    SetLastError( 0xdeadbeef );
+    port = CreateIoCompletionPort( hfile, NULL, 0x1234, 0 );
+    ok( port != NULL, "CreateIoCompletionPort on a non-overlapped handle failed, error %lu\n",
+        GetLastError() );
+    if (!port)
+    {
+        CloseHandle( hfile );
+        DeleteFileA( file_name );
+        return;
+    }
+
+    /* synchronous I/O on the handle still works */
+    ret = WriteFile( hfile, buffer, sizeof(buffer), &written, NULL );
+    ok( ret && written == sizeof(buffer), "WriteFile failed, error %lu\n", GetLastError() );
+
+    SetFilePointer( hfile, 0, NULL, FILE_BEGIN );
+    memset( read_buffer, 0, sizeof(read_buffer) );
