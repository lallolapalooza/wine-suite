+/* A minimal binary (regf) hive: Wine's RegSaveKey() only writes the text
+ * "WINE REGISTRY Version 2" format, so the file is built by hand.  Wine's
+ * RegLoadAppKey() reader takes the cell and field offsets below. */
+#define REGF_HBIN_OFF         0x1000
+#define REGF_HBIN_SIZE        0x1000
+
+/* cell offsets, relative to the start of the hbins */
+#define REGF_ROOT_NK          0x20
+#define REGF_ROOT_VALUES      0x78
+#define REGF_ROOT_VALUE       0x80
+#define REGF_SUBKEY_LIST      0xa0
+#define REGF_SUBKEY_NK        0xb0
+#define REGF_SUBKEY_VALUES    0x108
+#define REGF_SUBKEY_VALUE     0x110
+#define REGF_SUBKEY_DATA      0x130
+
+#define REGF_TEST_DWORD       0x12345678
+#define REGF_TEST_STRING      "hello"
+
+/* offset in the file of a field inside a cell */
+#define REGF_FIELD(cell,field) (REGF_HBIN_OFF + (cell) + (field))
+
+static void regf_put_u16(BYTE *buf, DWORD off, USHORT val)
+{
+    memcpy(buf + off, &val, sizeof(val));
+}
+
+static void regf_put_u32(BYTE *buf, DWORD off, DWORD val)
+{
+    memcpy(buf + off, &val, sizeof(val));
+}
+
+/* build a hive whose root key has an inline REG_DWORD value "Count" and a
+ * single subkey "Sub" holding a REG_SZ value "Label" */
+static void build_regf_hive(BYTE *buf)
+{
+    static const WCHAR test_string[] = L"hello";
+
+    memset(buf, 0, REGF_HBIN_OFF + REGF_HBIN_SIZE);
+
+    /* base block */
+    memcpy(buf, "regf", 4);
+    regf_put_u32(buf, 0x14, 1);                          /* version major */
+    regf_put_u32(buf, 0x18, 3);                          /* version minor */
+    regf_put_u32(buf, 0x1c, 0);                          /* primary file */
+    regf_put_u32(buf, 0x24, REGF_ROOT_NK);               /* root cell offset */
+    regf_put_u32(buf, 0x28, REGF_HBIN_SIZE);             /* size of the hbins */
+
+    /* hbin header */
+    memcpy(buf + REGF_HBIN_OFF, "hbin", 4);
+    regf_put_u32(buf, REGF_HBIN_OFF + 0x08, REGF_HBIN_SIZE);
+
+    /* root key */
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_NK, 0x00), 0xffffffa8);   /* -0x58 */
+    memcpy(buf + REGF_FIELD(REGF_ROOT_NK, 0x04), "nk", 2);
+    regf_put_u16(buf, REGF_FIELD(REGF_ROOT_NK, 0x06), 0x20);        /* KEY_COMP_NAME */
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_NK, 0x18), 1);           /* subkey count */
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_NK, 0x20), REGF_SUBKEY_LIST);
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_NK, 0x28), 1);           /* value count */
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_NK, 0x2c), REGF_ROOT_VALUES);
+    regf_put_u16(buf, REGF_FIELD(REGF_ROOT_NK, 0x4c), 4);           /* name length */
+    memcpy(buf + REGF_FIELD(REGF_ROOT_NK, 0x50), "Root", 4);
+
+    /* list of the root key's values */
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_VALUES, 0x00), 0xfffffff8);
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_VALUES, 0x04), REGF_ROOT_VALUE);
+
+    /* root value: REG_DWORD stored inline in the data offset */
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_VALUE, 0x00), 0xffffffe0);   /* -0x20 */
+    memcpy(buf + REGF_FIELD(REGF_ROOT_VALUE, 0x04), "vk", 2);
+    regf_put_u16(buf, REGF_FIELD(REGF_ROOT_VALUE, 0x06), 5);            /* "Count" */
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_VALUE, 0x08), 0x80000004);   /* inline, 4 bytes */
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_VALUE, 0x0c), REGF_TEST_DWORD);
+    regf_put_u32(buf, REGF_FIELD(REGF_ROOT_VALUE, 0x10), REG_DWORD);
+    regf_put_u16(buf, REGF_FIELD(REGF_ROOT_VALUE, 0x14), 0x0001);       /* VAL_COMP_NAME */
+    memcpy(buf + REGF_FIELD(REGF_ROOT_VALUE, 0x18), "Count", 5);
+
+    /* list of the root key's subkeys (an "lf" leaf) */
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_LIST, 0x00), 0xfffffff0);  /* -0x10 */
+    memcpy(buf + REGF_FIELD(REGF_SUBKEY_LIST, 0x04), "lf", 2);
+    regf_put_u16(buf, REGF_FIELD(REGF_SUBKEY_LIST, 0x06), 1);
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_LIST, 0x08), REGF_SUBKEY_NK);
+
+    /* subkey "Sub" */
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_NK, 0x00), 0xffffffa8);    /* -0x58 */
+    memcpy(buf + REGF_FIELD(REGF_SUBKEY_NK, 0x04), "nk", 2);
+    regf_put_u16(buf, REGF_FIELD(REGF_SUBKEY_NK, 0x06), 0x20);
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_NK, 0x28), 1);             /* value count */
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_NK, 0x2c), REGF_SUBKEY_VALUES);
+    regf_put_u16(buf, REGF_FIELD(REGF_SUBKEY_NK, 0x4c), 3);
+    memcpy(buf + REGF_FIELD(REGF_SUBKEY_NK, 0x50), "Sub", 3);
+
+    /* list of the subkey's values */
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_VALUES, 0x00), 0xfffffff8);
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_VALUES, 0x04), REGF_SUBKEY_VALUE);
+
+    /* subkey value: REG_SZ stored in a separate data cell; value data is UTF-16LE
+     * as in a real hive */
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_VALUE, 0x00), 0xffffffe0);  /* -0x20 */
+    memcpy(buf + REGF_FIELD(REGF_SUBKEY_VALUE, 0x04), "vk", 2);
+    regf_put_u16(buf, REGF_FIELD(REGF_SUBKEY_VALUE, 0x06), 5);          /* "Label" */
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_VALUE, 0x08), sizeof(test_string));
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_VALUE, 0x0c), REGF_SUBKEY_DATA);
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_VALUE, 0x10), REG_SZ);
+    regf_put_u16(buf, REGF_FIELD(REGF_SUBKEY_VALUE, 0x14), 0x0001);
+    memcpy(buf + REGF_FIELD(REGF_SUBKEY_VALUE, 0x18), "Label", 5);
+
+    /* subkey value data */
+    regf_put_u32(buf, REGF_FIELD(REGF_SUBKEY_DATA, 0x00), 0xfffffff0);   /* -0x10 */
+    memcpy(buf + REGF_FIELD(REGF_SUBKEY_DATA, 0x04), test_string, sizeof(test_string));
+}
+
+static void test_reg_load_app_key_regf(void)
+{
+    char hivefilepath[MAX_PATH];
+    BYTE hive[REGF_HBIN_OFF + REGF_HBIN_SIZE];
+    BYTE output[sizeof(REGF_TEST_STRING)];
+    HKEY appkey = NULL, subkey = NULL;
+    DWORD ret, type, size, value, written;
+    HANDLE file;
+
+    build_regf_hive(hive);
+
+    if (GetTempPathA(MAX_PATH, hivefilepath) + strlen("wine_reg_appkey.hiv") >= MAX_PATH)
+    {
+        skip("temp path is too long\n");
+        return;
+    }
+    strcat(hivefilepath, "wine_reg_appkey.hiv");
+
+    file = CreateFileA(hivefilepath, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "failed to create %s, error %lu\n", hivefilepath, GetLastError());
+    if (file == INVALID_HANDLE_VALUE) return;
+    ok(WriteFile(file, hive, sizeof(hive), &written, NULL) && written == sizeof(hive),
+       "failed to write %s, error %lu\n", hivefilepath, GetLastError());
+    CloseHandle(file);
+
+    ret = RegLoadAppKeyA(hivefilepath, &appkey, KEY_READ | KEY_WRITE, 0, 0);
+    ok(ret == ERROR_SUCCESS, "RegLoadAppKeyA failed, error %lu\n", ret);
+
+    value = 0;
+    size = sizeof(value);
+    type = 0;
+    ret = RegQueryValueExA(appkey, "Count", NULL, &type, (BYTE *)&value, &size);
+    ok(ret == ERROR_SUCCESS, "RegQueryValueExA(Count) failed, error %lu\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        ok(type == REG_DWORD, "unexpected type %lu\n", type);
+        ok(size == sizeof(value), "unexpected size %lu\n", size);
+        ok(value == REGF_TEST_DWORD, "unexpected value %#lx\n", value);
+    }
+
+    ret = RegOpenKeyExA(appkey, "Sub", 0, KEY_READ, &subkey);
+    ok(ret == ERROR_SUCCESS, "RegOpenKeyExA(Sub) failed, error %lu\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        memset(output, 0xcc, sizeof(output));
+        size = sizeof(output);
+        type = 0;
+        ret = RegQueryValueExA(subkey, "Label", NULL, &type, output, &size);
+        ok(ret == ERROR_SUCCESS, "RegQueryValueExA(Label) failed, error %lu\n", ret);
+        if (ret == ERROR_SUCCESS)
+        {
+            ok(type == REG_SZ, "unexpected type %lu\n", type);
+            ok(size == sizeof(REGF_TEST_STRING), "unexpected size %lu\n", size);
+            ok(!memcmp(output, REGF_TEST_STRING, sizeof(REGF_TEST_STRING)),
+               "unexpected data %s\n", output);
+        }
+        RegCloseKey(subkey);
+    }
+
+    /* values can also be created on the loaded key */
+    value = 0xcafebabe;
+    ret = RegSetValueExA(appkey, "NewValue", 0, REG_DWORD, (const BYTE *)&value, sizeof(value));
+    ok(ret == ERROR_SUCCESS, "RegSetValueExA(NewValue) failed, error %lu\n", ret);
+
+    value = 0;
+    size = sizeof(value);
+    ret = RegQueryValueExA(appkey, "NewValue", NULL, &type, (BYTE *)&value, &size);
+    ok(ret == ERROR_SUCCESS, "RegQueryValueExA(NewValue) failed, error %lu\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        ok(type == REG_DWORD, "unexpected type %lu\n", type);
+        ok(value == 0xcafebabe, "unexpected value %#lx\n", value);
+    }
+
+    ret = RegCloseKey(appkey);
+    ok(ret == ERROR_SUCCESS, "RegCloseKey failed, error %lu\n", ret);
+
+    file = CreateFileA(hivefilepath, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                       OPEN_EXISTING, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "hive file is still in use, error %lu\n", GetLastError());
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+    ok(DeleteFileA(hivefilepath), "failed to delete %s, error %lu\n", hivefilepath, GetLastError());
+}
