+/* A handle that Wine creates for a Unix pipe inherited from the parent process
+ * (stdio redirected to a pipe by the Unix shell, e.g. `printf data | wine
+ * ntdll_test.exe pipe`) is an fd-backed file object, not a named pipe object.
+ * GetFileType() reports it as a pipe, but unlike a Wine named pipe object it
+ * doesn't implement GetNamedPipeInfo(); that's what tells the two apart here. */
+static BOOL is_fd_backed_pipe( HANDLE handle )
+{
+    if (!handle || handle == INVALID_HANDLE_VALUE) return FALSE;
+    if (GetFileType( handle ) != FILE_TYPE_PIPE) return FALSE;
+    return !GetNamedPipeInfo( handle, NULL, NULL, NULL, NULL );
+}
+
+static void test_unix_pipe_handle( HANDLE handle, BOOL read_end )
+{
+    FILE_PIPE_PEEK_BUFFER peek;
+    FILE_PIPE_INFORMATION info;
+    IO_STATUS_BLOCK iosb;
+    ULONG_PTR total, avail;
+    DWORD mode, pipe_avail;
+    NTSTATUS status;
+    char buffer[32];
+    BOOL ret;
+    int i;
+
+    /* such a pipe always is a byte stream blocking pipe, so byte mode with
+       queue-operation completion is accepted on it */
+    info.ReadMode = FILE_PIPE_BYTE_STREAM_MODE;
+    info.CompletionMode = FILE_PIPE_QUEUE_OPERATION;
+    status = pNtSetInformationFile( handle, &iosb, &info, sizeof(info), FilePipeInformation );
+    ok( !status, "NtSetInformationFile(FilePipeInformation) on a Unix pipe returned %#lx\n", status );
+
+    /* but it has no message queue, so message mode reads are not valid on it */
+    info.ReadMode = FILE_PIPE_MESSAGE_MODE;
+    info.CompletionMode = FILE_PIPE_QUEUE_OPERATION;
+    status = pNtSetInformationFile( handle, &iosb, &info, sizeof(info), FilePipeInformation );
+    ok( status == STATUS_INVALID_PARAMETER,
+        "NtSetInformationFile(message mode) on a Unix pipe returned %#lx\n", status );
+
+    /* the same requests through the public API used by libuv (and thus Node.js) */
+    mode = PIPE_READMODE_BYTE | PIPE_WAIT;
+    SetLastError( 0xdeadbeef );
+    ret = SetNamedPipeHandleState( handle, &mode, NULL, NULL );
+    ok( ret, "SetNamedPipeHandleState on a Unix pipe failed, error %lu\n", GetLastError() );
+
+    if (!read_end) return;
+
+    /* wait for the data the parent wrote to the pipe (bounded, deterministic:
+       the parent writes it before the process starts) */
+    for (i = 0; i < 1000; i++)
+    {
+        memset( &peek, 0, sizeof(peek) );
+        status = pNtFsControlFile( handle, NULL, NULL, NULL, &iosb, FSCTL_PIPE_PEEK,
+                                   NULL, 0, &peek, sizeof(peek) );
+        if (status != STATUS_SUCCESS || peek.ReadDataAvailable) break;
+        Sleep( 1 );
+    }
+    if (status == STATUS_PIPE_BROKEN)
+    {
+        win_skip( "the piped stdin is already closed without data\n" );
+        return;
+    }
+    ok( !status, "FSCTL_PIPE_PEEK on a Unix pipe returned %#lx\n", status );
+    ok( peek.NamedPipeState == FILE_PIPE_CONNECTED_STATE,
+        "got NamedPipeState %#lx\n", peek.NamedPipeState );
+    avail = peek.ReadDataAvailable;
+
+    /* the same through the public API; peeking doesn't consume the data */
+    pipe_avail = 0;
+    SetLastError( 0xdeadbeef );
+    ret = PeekNamedPipe( handle, NULL, 0, NULL, &pipe_avail, NULL );
+    ok( ret, "PeekNamedPipe on a Unix pipe failed, error %lu\n", GetLastError() );
+    ok( pipe_avail == avail, "PeekNamedPipe reported %lu bytes, FSCTL_PIPE_PEEK %Iu\n",
+        pipe_avail, avail );
+
+    if (!avail)
+    {
+        win_skip( "the piped stdin is empty\n" );
+        return;
+    }
+
+    /* the bytes FSCTL_PIPE_PEEK reported are the ones that can be read */
+    total = 0;
+    while (total < avail)
+    {
+        iosb.Information = 0;
+        status = NtReadFile( handle, NULL, NULL, NULL, &iosb, buffer, sizeof(buffer), NULL, NULL );
+        ok( !status && iosb.Information, "NtReadFile on a Unix pipe returned %#lx, information %Iu\n",
+            status, iosb.Information );
+        if (status || !iosb.Information) break;
+        total += iosb.Information;
+    }
+    ok( total == avail, "FSCTL_PIPE_PEEK reported %Iu bytes but %Iu were read\n", avail, total );
+
+    /* once the Unix parent has closed the write end of the pipe a zero-length
+       read fails, like on Windows */
+    memset( &peek, 0, sizeof(peek) );
+    status = pNtFsControlFile( handle, NULL, NULL, NULL, &iosb, FSCTL_PIPE_PEEK,
+                               NULL, 0, &peek, sizeof(peek) );
+    if (status == STATUS_PIPE_BROKEN)
+    {
+        status = NtReadFile( handle, NULL, NULL, NULL, &iosb, buffer, 0, NULL, NULL );
+        ok( status == STATUS_PIPE_BROKEN,
+            "zero-length NtReadFile on a closed Unix pipe returned %#lx\n", status );
+    }
+    else win_skip( "the write end of the piped stdin is still open, skipping the EOF check\n" );
+}
+
+static void test_unix_pipe_semantics( void )
+{
+    HANDLE handle = GetStdHandle( STD_INPUT_HANDLE );
+
+    if (is_fd_backed_pipe( handle ))
+        test_unix_pipe_handle( handle, TRUE );
+    else
+        win_skip( "stdin is not a Unix pipe, run as `printf PIPEDATA | wine ntdll_test.exe pipe`\n" );
+
+    handle = GetStdHandle( STD_OUTPUT_HANDLE );
+    if (is_fd_backed_pipe( handle ))
+        test_unix_pipe_handle( handle, FALSE );
+}
+
+/* the same operations on a real Windows-style (Wine named pipe) anonymous pipe,
+   for reference */
+static void test_named_pipe_semantics( void )
+{
+    static const char testdata[] = "PIPEDATA";
+    FILE_PIPE_PEEK_BUFFER peek;
+    FILE_PIPE_INFORMATION info;
+    IO_STATUS_BLOCK iosb;
+    HANDLE read, write;
+    DWORD written;
+    NTSTATUS status;
+    char buffer[32];
+
+    ok( CreatePipe( &read, &write, NULL, 0 ), "CreatePipe failed, error %lu\n", GetLastError() );
+
+    ok( WriteFile( write, testdata, sizeof(testdata) - 1, &written, NULL ),
+        "WriteFile failed, error %lu\n", GetLastError() );
+    ok( written == sizeof(testdata) - 1, "wrote %lu bytes\n", written );
+
+    info.ReadMode = FILE_PIPE_BYTE_STREAM_MODE;
+    info.CompletionMode = FILE_PIPE_QUEUE_OPERATION;
+    status = pNtSetInformationFile( read, &iosb, &info, sizeof(info), FilePipeInformation );
+    ok( !status, "NtSetInformationFile(FilePipeInformation) on a named pipe returned %#lx\n", status );
+
+    memset( &peek, 0, sizeof(peek) );
+    status = pNtFsControlFile( read, NULL, NULL, NULL, &iosb, FSCTL_PIPE_PEEK,
+                               NULL, 0, &peek, sizeof(peek) );
+    ok( !status, "FSCTL_PIPE_PEEK on a named pipe returned %#lx\n", status );
+    ok( peek.ReadDataAvailable == sizeof(testdata) - 1, "got ReadDataAvailable %lu\n", peek.ReadDataAvailable );
+
+    ok( CloseHandle( write ), "CloseHandle failed, error %lu\n", GetLastError() );
+
+    memset( buffer, 0, sizeof(buffer) );
+    status = NtReadFile( read, NULL, NULL, NULL, &iosb, buffer, sizeof(testdata) - 1, NULL, NULL );
+    ok( !status, "NtReadFile on a named pipe returned %#lx\n", status );
+    ok( iosb.Information == sizeof(testdata) - 1, "read %Iu bytes\n", iosb.Information );
+    ok( !memcmp( buffer, testdata, sizeof(testdata) - 1 ), "got wrong data\n" );
+
+    status = NtReadFile( read, NULL, NULL, NULL, &iosb, buffer, 0, NULL, NULL );
+    ok( status == STATUS_PIPE_BROKEN,
+        "zero-length NtReadFile on a broken named pipe returned %#lx\n", status );
+
+    CloseHandle( read );
+}
