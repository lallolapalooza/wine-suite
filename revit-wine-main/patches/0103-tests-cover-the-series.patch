+    ok(hres == S_OK, "MapUrlToZone failed: %08lx\n", hres);
+    ok(zone == URLZONE_INTERNET, "zone=%ld, expected URLZONE_INTERNET\n", zone);
+
+    /* A res: URL that does have a host is unaffected by the empty-host rule. */
+    zone = 100;
+    hres = IInternetSecurityManager_MapUrlToZone(secmgr, res_with_host, &zone, 0);
+    ok(hres == S_OK, "MapUrlToZone failed: %08lx\n", hres);
+    ok(zone == URLZONE_INTERNET, "zone=%ld, expected URLZONE_INTERNET\n", zone);
+
+    /* Controls: ordinary hierarchical schemes still map to the Internet zone. */
+    zone = 100;
+    hres = IInternetSecurityManager_MapUrlToZone(secmgr, http_url, &zone, 0);
+    ok(hres == S_OK, "MapUrlToZone failed: %08lx\n", hres);
+    ok(zone == URLZONE_INTERNET, "zone=%ld, expected URLZONE_INTERNET\n", zone);
+
+    zone = 100;
+    hres = IInternetSecurityManager_MapUrlToZone(secmgr, ftp_url, &zone, 0);
+    ok(hres == S_OK, "MapUrlToZone failed: %08lx\n", hres);
+    ok(zone == URLZONE_INTERNET, "zone=%ld, expected URLZONE_INTERNET\n", zone);
+
+    IInternetSecurityManager_Release(secmgr);
+}
