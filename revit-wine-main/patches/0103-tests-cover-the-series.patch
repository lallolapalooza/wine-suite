+/* Windows resolves names through %SystemRoot%\system32\drivers\etc\hosts before asking DNS.  Make
+ * sure an entry written there by an application (an installer, for instance) is honoured: add a
+ * unique entry to the hosts file of the current prefix, resolve it, then remove it again. */
+static void test_getaddrinfo_hosts_file(void)
+{
+    static const char host_name[] = "wine-ws2_32-hosts-test.invalid";
+    static const char host_entry[] = "127.0.0.1 wine-ws2_32-hosts-test.invalid\n";
+    char path[MAX_PATH], *content, *new_content;
+    struct sockaddr_in *sin;
+    struct in_addr expected;
+    ADDRINFOA hints, *result = NULL;
+    DWORD size, written, len;
+    HANDLE file;
+    int ret;
+
+    len = GetWindowsDirectoryA( path, ARRAY_SIZE(path) );
+    if (!len || len > ARRAY_SIZE(path) - sizeof("\\system32\\drivers\\etc\\hosts"))
+    {
+        win_skip( "cannot determine the Windows directory\n" );
+        return;
+    }
+    strcat( path, "\\system32\\drivers\\etc\\hosts" );
+
+    file = CreateFileA( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                        NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        win_skip( "cannot open %s, skipping the hosts file test\n", wine_dbgstr_a(path) );
+        return;
+    }
+
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || size > 64 * 1024)
+    {
+        win_skip( "cannot read %s\n", wine_dbgstr_a(path) );
+        CloseHandle( file );
+        return;
+    }
+    content = malloc( size + 1 );
+    new_content = malloc( sizeof(host_entry) + size );
+    if (!content || !new_content)
+    {
+        win_skip( "out of memory\n" );
+        CloseHandle( file );
+        free( content );
+        free( new_content );
+        return;
+    }
+    SetFilePointer( file, 0, NULL, FILE_BEGIN );
+    if (!ReadFile( file, content, size, &written, NULL ) || written != size)
+    {
+        win_skip( "cannot read %s\n", wine_dbgstr_a(path) );
+        CloseHandle( file );
+        free( content );
+        free( new_content );
+        return;
+    }
+    content[size] = 0;
+
+    /* put the entry first: the address of an entry that is present is the one that must be used */
+    memcpy( new_content, host_entry, sizeof(host_entry) - 1 );
+    memcpy( new_content + sizeof(host_entry) - 1, content, size );
+    SetFilePointer( file, 0, NULL, FILE_BEGIN );
+    if (!WriteFile( file, new_content, sizeof(host_entry) - 1 + size, &written, NULL )
+        || written != sizeof(host_entry) - 1 + size)
+    {
+        win_skip( "cannot write %s\n", wine_dbgstr_a(path) );
+        SetFilePointer( file, 0, NULL, FILE_BEGIN );
+        WriteFile( file, content, size, &written, NULL );
+        SetEndOfFile( file );
+        CloseHandle( file );
+        free( content );
+        free( new_content );
+        return;
+    }
+    SetEndOfFile( file );
+    CloseHandle( file );
+
+    memset( &hints, 0, sizeof(hints) );
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    ret = getaddrinfo( host_name, NULL, &hints, &result );
+    ok( !ret, "getaddrinfo(%s) failed with error %d\n", host_name, ret );
+    if (!ret)
+    {
+        expected.s_addr = inet_addr( "127.0.0.1" );
+        ok( result != NULL, "no address returned for %s\n", host_name );
+        if (result)
+        {
+            ok( result->ai_family == AF_INET, "got family %d\n", result->ai_family );
+            sin = (struct sockaddr_in *)result->ai_addr;
+            ok( sin && !memcmp( &sin->sin_addr, &expected, sizeof(expected) ),
+                "got address %s for %s\n", sin ? inet_ntoa( sin->sin_addr ) : "(none)", host_name );
+            freeaddrinfo( result );
+        }
+    }
+
+    /* remove the entry again */
+    file = CreateFileA( path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+                        FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE)
+        ok( 0, "cannot reopen %s to restore it: %lu\n", wine_dbgstr_a(path), GetLastError() );
+    else
+    {
+        SetFilePointer( file, 0, NULL, FILE_BEGIN );
+        ok( WriteFile( file, content, size, &written, NULL ) && written == size,
+            "cannot restore %s\n", wine_dbgstr_a(path) );
+        SetEndOfFile( file );
+        CloseHandle( file );
+    }
+    free( content );
+    free( new_content );
+}
