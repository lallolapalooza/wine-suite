From: Revit-on-Wine fork
Subject: ncrypt: support importing ECC key blobs (Revit's startup crypto self-test)

SYMPTOM
  Revit 2027 aborts a few seconds into startup with

      Assertion failed: line 47 of F:\Ship\2027_px64\Source\Revit\PersistenceDB\Pipeline\DataIntegrity.cpp
      ExceptionCode=0xe06d7363 (an MSVC C++ throw) -> "An unrecoverable error has occurred" message box

  immediately after the journal logs the SystemSettings block.  Wine's own log shows the call that
  fails:

      fixme:ncrypt:NCryptOpenStorageProvider (..., L"Microsoft Software Key Storage Provider", 0): stub
      fixme:ncrypt:NCryptImportKey Silent flag not implemented
      fixme:ncrypt:NCryptImportKey Unhandled key magic 0x32534345

WHAT REVIT DOES (decompiled from PersistenceDB.dll, image base 0x180000000; its DataIntegrity.cpp
string is the only place in the image paired with line 47)
  0x180195d40  ASSERT(0 == helper(...));   -- helper 0x180195dc0:
      NCryptOpenStorageProvider(&ksp, L"Microsoft Software Key Storage Provider", 0);
      NCryptImportKey(ksp, NULL, L"ECCPRIVATEBLOB", NULL, &key, blob, cb, NCRYPT_SILENT_FLAG);
      if (status < 0) return 1;   /* -> the assert fires */
  with two hard-coded, byte-identical 104-byte blobs from Utility.dll's RCDATA resources 13536/13537
  (Utility.dll!ResourceSelector::loadResourceDataFile), whose header is
  45 43 53 32 20 00 00 00 = BCRYPT_ECDSA_PRIVATE_P256_MAGIC, cbKey = 32 (X||Y||d, i.e. ECDSA P-256).
  It is a self-test of the process's own CNG capability, not a check of on-disk data.

WINDOWS BEHAVIOUR RESTORED
  On Windows NCryptImportKey imports ECC key blobs; the import has the same shape for every CNG
  algorithm.  Wine's bcrypt already implements it (import_ecc_key with BCRYPT_ECCPRIVATE_BLOB /
  BCRYPT_ECCPUBLIC_BLOB for P-256/384/521); only ncrypt's dispatch was missing and returned
  NTE_INVALID_PARAMETER for any magic other than the three RSA ones.  This maps the ECDSA magics to
  the matching BCRYPT_ECDSA_*_ALG_HANDLE, hands the blob to BCryptImportKeyPair, and reports the key
  length (cbKey * 8) through NCRYPT_LENGTH_PROPERTY / BCRYPT_PUBLIC_KEY_LENGTH, as the RSA path does.

TEST
  dlls/ncrypt/tests/ncrypt.c: test_key_import_ecc() imports a P-256 private blob through
  BCRYPT_ECCPRIVATE_BLOB and a public blob through BCRYPT_ECCPUBLIC_BLOB, and checks the handle and
  the 256-bit NCRYPT_LENGTH_PROPERTY.  Run it with tools/run_wine_tests.sh ncrypt.

--- a/dlls/ncrypt/main.c
+++ b/dlls/ncrypt/main.c
@@ -150,9 +150,11 @@
         break;
 
     case ECDSA_P256:
+    case ECDSA_P384:
+    case ECDSA_P521:
         if (!(object = allocate_object(KEY))) return NULL;
 
-        object->key.algid = ECDSA_P256;
+        object->key.algid = algid;
         break;
 
     default:
@@ -445,6 +447,56 @@
         set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&rsablob->BitLength, sizeof(rsablob->BitLength));
         break;
     }
+    case BCRYPT_ECDSA_PRIVATE_P256_MAGIC:
+    case BCRYPT_ECDSA_PUBLIC_P256_MAGIC:
+    case BCRYPT_ECDSA_PRIVATE_P384_MAGIC:
+    case BCRYPT_ECDSA_PUBLIC_P384_MAGIC:
+    case BCRYPT_ECDSA_PRIVATE_P521_MAGIC:
+    case BCRYPT_ECDSA_PUBLIC_P521_MAGIC:
+    {
+        NTSTATUS status;
+        BCRYPT_ECCKEY_BLOB *eccblob = (BCRYPT_ECCKEY_BLOB *)data;
+        BCRYPT_ALG_HANDLE bcrypt_alg;
+        enum algid algid;
+        DWORD bitlen;
+
+        switch (header->Magic)
+        {
+        case BCRYPT_ECDSA_PRIVATE_P256_MAGIC:
+        case BCRYPT_ECDSA_PUBLIC_P256_MAGIC:
+            bcrypt_alg = BCRYPT_ECDSA_P256_ALG_HANDLE;
+            algid = ECDSA_P256;
+            break;
+        case BCRYPT_ECDSA_PRIVATE_P384_MAGIC:
+        case BCRYPT_ECDSA_PUBLIC_P384_MAGIC:
+            bcrypt_alg = BCRYPT_ECDSA_P384_ALG_HANDLE;
+            algid = ECDSA_P384;
+            break;
+        default:
+            bcrypt_alg = BCRYPT_ECDSA_P521_ALG_HANDLE;
+            algid = ECDSA_P521;
+            break;
+        }
+
+        if (!(object = create_key_object(algid, provider)))
+        {
+            ERR("Error allocating memory\n");
+            return NTE_NO_MEMORY;
+        }
+
+        status = BCryptImportKeyPair(bcrypt_alg, NULL, type, &object->key.bcrypt_key, data, datasize, 0);
+        if (status != STATUS_SUCCESS)
+        {
+            WARN("Error importing key pair %#lx\n", status);
+            free(object);
+            return map_ntstatus(status);
+        }
+
+        bitlen = eccblob->cbKey * 8;
+        set_object_property(object, NCRYPT_LENGTH_PROPERTY, (BYTE *)&bitlen, sizeof(bitlen));
+        set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&bitlen, sizeof(bitlen));
+        break;
+    }
     default:
         FIXME("Unhandled key magic %#lx\n", header->Magic);
         return NTE_INVALID_PARAMETER;
