+static void test_key_import_ecc(void)
+{
+    NCRYPT_PROV_HANDLE prov;
+    NCRYPT_KEY_HANDLE key;
+    SECURITY_STATUS ret;
+    DWORD keylength, size;
+
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+
+    key = 0;
+    ret = NCryptImportKey(prov, 0, BCRYPT_ECCPRIVATE_BLOB, NULL, &key, ecc_private_key_blob,
+                          sizeof(ecc_private_key_blob), 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(key != 0, "got null handle\n");
+
+    keylength = 0;
+    size = 0;
+    ret = NCryptGetProperty(key, NCRYPT_LENGTH_PROPERTY, (BYTE *)&keylength, sizeof(keylength), &size, 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(size == sizeof(keylength), "got %lu\n", size);
+    ok(keylength == 256, "got %lu\n", keylength);
+    NCryptFreeObject(key);
+
+    key = 0;
+    ret = NCryptImportKey(prov, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, &key, ecc_public_key_blob,
+                          sizeof(ecc_public_key_blob), 0);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(key != 0, "got null handle\n");
+    NCryptFreeObject(key);
+
+    NCryptFreeObject(prov);
+}
+
 static void test_free_object(void)
 {
     NCRYPT_PROV_HANDLE prov;
