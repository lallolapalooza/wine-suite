++    todo_wine
++    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
++
++    hr = IDCompositionTarget_SetRoot(target2, visual);
++    todo_wine
++    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
