+From 25ae3560e14d39e2eef6c6df21d34253b67ce80e Mon Sep 17 00:00:00 2001
+From: Zhiyi Zhang <zzhang@codeweavers.com>
+Date: Fri, 13 Mar 2026 10:13:36 +0800
+Subject: [PATCH 60/65] dcomp: Use a global lock.
+
+For example, visual_SetContent() can be called when the composition thread is running.
+This is needed because Commit() is executed immediately unlike Windows, which uses a command list.
+---
+ dlls/dcomp/dcomp_private.h |  1 -
+ dlls/dcomp/device.c        | 12 +++++-------
+ dlls/dcomp/target.c        | 17 +++++++++++------
+ dlls/dcomp/visual.c        |  9 +++++++++
+ 4 files changed, 25 insertions(+), 14 deletions(-)
+
+diff --git a/dlls/dcomp/dcomp_private.h b/dlls/dcomp/dcomp_private.h
+index 0e8a66fd686..0d70011f0c9 100644
+--- a/dlls/dcomp/dcomp_private.h
++++ b/dlls/dcomp/dcomp_private.h
+@@ -29,7 +29,6 @@ struct composition_device
+     IDCompositionDevice IDCompositionDevice_iface;
+     IDCompositionDeviceUnknown IDCompositionDeviceUnknown_iface;
+     IDCompositionSurface *drawing_surface;
+-    CRITICAL_SECTION cs;
+     struct list targets;
+     HANDLE thread;
+     BOOL exit_thread;
+diff --git a/dlls/dcomp/device.c b/dlls/dcomp/device.c
+index 8d9099db5b6..c4ea896ccfc 100644
+--- a/dlls/dcomp/device.c
++++ b/dlls/dcomp/device.c
+@@ -115,7 +115,6 @@ static ULONG STDMETHODCALLTYPE device_Release(IDCompositionDevice *iface)
+             WaitForSingleObject(device->thread, INFINITE);
+             CloseHandle(device->thread);
+         }
+-        DeleteCriticalSection(&device->cs);
+         free(device);
+     }
+ 
+@@ -621,7 +620,7 @@ static DWORD WINAPI composite_thread_proc(void *iface)
+ 
+     while (TRUE)
+     {
+-        EnterCriticalSection(&device->cs);
++        dcomp_lock();
+ 
+         count = 0;
+         LIST_FOR_EACH_ENTRY(target, &device->targets, struct composition_target, entry)
+@@ -641,11 +640,11 @@ static DWORD WINAPI composite_thread_proc(void *iface)
+         {
+             TRACE("Composition thread exited.\n");
+             device->thread_exited = TRUE;
+-            LeaveCriticalSection(&device->cs);
++            dcomp_unlock();
+             break;
+         }
+ 
+-        LeaveCriticalSection(&device->cs);
++        dcomp_unlock();
+ 
+         if (device->exit_thread)
+             break;
+@@ -663,7 +662,7 @@ static HRESULT STDMETHODCALLTYPE device_Commit(IDCompositionDevice *iface)
+ 
+     FIXME("iface %p semi-stub!\n", iface);
+ 
