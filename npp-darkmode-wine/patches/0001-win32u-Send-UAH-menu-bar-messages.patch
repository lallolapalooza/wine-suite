+        COLORREF bk_col = (item->fState & MF_HILITE) ? DARK_MENU_HIGHLIGHT : DARK_MENU_BACKGROUND;
+
+        NtGdiGetAndSetDCDword( hdc, NtGdiSetTextColor, text_col, NULL );
+        NtGdiGetAndSetDCDword( hdc, NtGdiSetBkColor, bk_col, NULL );
+    }
