From: omp <omp@localhost>
Subject: [PATCH 1/3] win32u: Let the application draw a dark menu bar

Windows 10 1809+ sends the undocumented UAH messages (WM_UAHDRAWMENU /
WM_UAHDRAWMENUITEM) to windows that use dark mode, letting the application
paint the menu bar itself. Notepad++ 8.x relies on this to theme its menu bar.

A window is considered dark when the __wine_dark_mode property is set, which
is done by uxtheme's AllowDarkModeForWindow and by dwmapi's
DWMWA_USE_IMMERSIVE_DARK_MODE attribute.
---
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -2389,13 +2389,53 @@
     NtGdiDeleteObjectApp( mem_hdc );
 }
 
+/* dark mode colours for popup menus, following the Windows dark theme */
+#define DARK_MENU_BACKGROUND 0x00202020  /* RGB(32,32,32) */
+#define DARK_MENU_HIGHLIGHT  0x00454545  /* RGB(69,69,69) */
+#define DARK_MENU_BORDER     0x00646464  /* RGB(100,100,100) */
+#define DARK_MENU_TEXT       0x00e0e0e0  /* RGB(224,224,224) */
+#define DARK_MENU_DISABLED   0x00808080  /* RGB(128,128,128) */
+
+/* Window property used to mark a window as using dark mode: 1 means dark,
+ * 2 means explicitly light, absent means unset. It is set by uxtheme's
+ * AllowDarkModeForWindow and by DwmSetWindowAttribute(DWMWA_USE_IMMERSIVE_DARK_MODE). */
+static const WCHAR dark_mode_property[] =
+    {'_','_','w','i','n','e','_','d','a','r','k','_','m','o','d','e',0};
+
+static BOOL is_dark_mode_allowed_for_window( HWND hwnd )
+{
+    return NtUserGetProp( hwnd, dark_mode_property ) == (HANDLE)1;
+}
+
+enum dark_menu_brush
+{
+    DARK_MENU_BRUSH_BACKGROUND,
+    DARK_MENU_BRUSH_HIGHLIGHT,
+    DARK_MENU_BRUSH_BORDER,
+};
+
+static HBRUSH get_dark_menu_brush( enum dark_menu_brush kind )
+{
+    static const COLORREF colors[3] = { DARK_MENU_BACKGROUND, DARK_MENU_HIGHLIGHT, DARK_MENU_BORDER };
+    static HBRUSH brushes[3];
+
+    if (!brushes[kind])
+        brushes[kind] = NtGdiCreateSolidBrush( colors[kind], NULL );
+    return brushes[kind];
+}
+
+static BOOL menu_is_dark( struct menu *menu )
+{
+    return menu && is_dark_mode_allowed_for_window( menu->hwndOwner );
+}
+
