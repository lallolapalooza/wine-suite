+/* undocumented dark mode menu bar messages (Windows 10 1809+ UAH protocol) */
+#define WM_UAHINITMENU         0x0093
+#define WM_UAHDRAWMENU         0x0091
+#define WM_UAHDRAWMENUITEM     0x0092
+#define WM_UAHMEASUREMENUITEM  0x0094
+#define WM_UAHNCPAINTMENUPOPUP 0x0095
+
+typedef struct tagUAHMENU
+{
+    HMENU hmenu;
+    HDC   hdc;
+    DWORD dwFlags;
+} UAHMENU;
+
+typedef union tagUAHMENUITEMMETRICS
+{
+    struct { DWORD cx; DWORD cy; } rgsizeBar[2];
+    struct { DWORD cx; DWORD cy; } rgsizePopup[4];
+} UAHMENUITEMMETRICS;
+
+typedef struct tagUAHMENUPOPUPMETRICS
+{
+    DWORD rgcx[4];
+    DWORD fUpdateMaxWidths : 2;
+} UAHMENUPOPUPMETRICS;
+
+typedef struct tagUAHMENUITEM
+{
+    int iPosition;
+    UAHMENUITEMMETRICS umim;
+    UAHMENUPOPUPMETRICS umpm;
+} UAHMENUITEM;
+
+typedef struct tagUAHDRAWMENUITEM
+{
+    DRAWITEMSTRUCT dis;
+    UAHMENU um;
+    UAHMENUITEM umi;
+} UAHDRAWMENUITEM;
+
+/* Ask the application to draw the menu bar itself, the way Windows 10 1809+
+ * does for windows that opted into dark mode. Applications that handle these
+ * messages paint the whole bar, so the default drawing must then be skipped. */
+static BOOL draw_dark_menu_bar( HWND hwnd, HDC hdc, struct menu *menu )
+{
+    UAHDRAWMENUITEM udmi;
+    UAHMENU um;
+    UINT i;
+
+    if (!menu->nItems || !is_dark_mode_allowed_for_window( hwnd )) return FALSE;
+
+    um.hmenu   = menu->handle;
+    um.hdc     = hdc;
+    um.dwFlags = 0x00000a00;
+
+    send_message( hwnd, WM_UAHINITMENU, 0, 0 );
+    send_message( hwnd, WM_UAHDRAWMENU, 0, (LPARAM)&um );
+
+    memset( &udmi, 0, sizeof(udmi) );
+    udmi.um = um;
+
+    for (i = 0; i < menu->nItems; i++)
+    {
+        struct menu_item *item = &menu->items[i];
+        RECT rc = item->rect;
+
+        adjust_menu_item_rect( menu, &rc );
+
+        udmi.dis.CtlType    = ODT_MENU;
+        udmi.dis.CtlID      = 0;
+        udmi.dis.itemID     = 0;
+        udmi.dis.itemAction = ODA_DRAWENTIRE;
+        udmi.dis.itemState  = 0;
+        if (item->fState & MF_CHECKED)  udmi.dis.itemState |= ODS_CHECKED;
+        if (item->fState & MF_DISABLED) udmi.dis.itemState |= ODS_DISABLED;
+        if (item->fState & MF_GRAYED)   udmi.dis.itemState |= ODS_GRAYED | ODS_DISABLED;
+        if (item->fState & MF_HILITE)   udmi.dis.itemState |= ODS_SELECTED;
+        udmi.dis.hwndItem   = hwnd;
+        udmi.dis.hDC        = hdc;
+        udmi.dis.rcItem     = rc;
+        udmi.dis.itemData   = 0;
+
+        udmi.umi.iPosition = i;
+        udmi.umi.umim.rgsizeBar[0].cx = rc.right - rc.left;
+        udmi.umi.umim.rgsizeBar[0].cy = rc.bottom - rc.top;
+
+        send_message( hwnd, WM_UAHDRAWMENUITEM, 0, (LPARAM)&udmi );
+    }
+
+    return TRUE;
+}
+
