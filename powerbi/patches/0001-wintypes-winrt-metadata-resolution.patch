+    if (FAILED(hr = WindowsCreateString( type_name, type_name_length, &name ))) return FALSE;
+    hr = RoGetActivationFactory( name, &IID_IActivationFactory, (void **)&factory );
+    if (factory) IActivationFactory_Release( factory );
