+     * returned above. */
+    if (subNamespaces)
+        add_child_namespaces( &files, namespace_name, name_length, &sub_namespace_names );
+
+    TRACE("resolved %s to %lu metadata files and %lu sub-namespaces\n", debugstr_hstring(name), paths.count,
+          sub_namespace_names.count);
+
+    /* At least one file or one sub-namespace has to have been found. */
+    found = paths.count || sub_namespace_names.count;
+
+    hr = S_OK;
+    if (metaDataFilePaths)
+        hr = create_hstring_array( &paths, metaDataFilePathsCount, metaDataFilePaths );
+    if (SUCCEEDED(hr) && subNamespaces)
+        hr = create_hstring_array( &sub_namespace_names, subNamespacesCount, subNamespaces );
+
+    metadata_file_list_free( &files );
+    string_list_free( &directories );
+    string_list_free( &paths );
+    string_list_free( &sub_namespace_names );
+
+    if (FAILED(hr)) return hr;
+    return found ? S_OK : RO_E_METADATA_NAME_NOT_FOUND;
+}
+
+/* Used to find the metadata file that describes a type: a file named after the namespace of the type is the
+ * most likely to describe its ABI, then the files whose name is a namespace prefix of it. */
+static int metadata_file_priority(const struct metadata_file *file, const WCHAR *namespace_name,
+                                  DWORD namespace_length)
+{
+    if (!namespace_is_under( namespace_name, namespace_length, file->base_name, wcslen( file->base_name ) ))
+        return 2;
+    if (wcslen( file->base_name ) == namespace_length) return 0;
+    return 1;
+}
+
+/* Finds the metadata file that declares 'type_name' and, when 'import' is set, opens it with a metadata
+ * reader and returns the token of the type's TypeDef. A file named after the namespace of the type is preferred,
+ * then the files whose name is a namespace prefix of it: that is where the ABI of a type is described, and the
+ * order matters because a type of an API contract is also declared by the files of the contract. */
+static HRESULT find_type_in_metadata(IMetaDataDispenser *dispenser, const struct metadata_file_list *files,
+                                    const WCHAR *type_name, WCHAR *path, DWORD path_length, mdTypeDef *type_def,
+                                    IMetaDataImport **import)
+{
+    const WCHAR *cursor;
+    DWORD namespace_length = 0, i, priority;
+
+    if (type_def) *type_def = mdTypeDefNil;
+    if (import) *import = NULL;
+    if ((cursor = wcsrchr( type_name, '.' ))) namespace_length = cursor - type_name;
+
+    for (priority = 0; priority < 3; priority++)
+    {
+        for (i = 0; i < files->count; i++)
+        {
+            IMetaDataImport *reader;
+            mdTypeDef token;
+
+            if (metadata_file_priority( &files->files[i], type_name, namespace_length ) != priority) continue;
+            if (FAILED(open_metadata_file( dispenser, files->files[i].path, &IID_IMetaDataImport,
+                                           (void **)&reader )))
+                continue;
+
+            if (SUCCEEDED(IMetaDataImport_FindTypeDefByName( reader, type_name, mdTokenNil, &token )))
+            {
+                TRACE("found %s in %s, token %#x\n", debugstr_w(type_name), debugstr_w(files->files[i].path),
+                      token);
+                if (path) lstrcpynW( path, files->files[i].path, path_length );
+                if (type_def) *type_def = token;
+                if (import) *import = reader;
+                else IMetaDataImport_Release( reader );
+                return S_OK;
+            }
+            IMetaDataImport_Release( reader );
+        }
+    }
 
     return RO_E_METADATA_NAME_NOT_FOUND;
 }
 
+/* TRUE when the metadata describes 'member_name' as a method or a field of 'type_name'. */
+static BOOL metadata_has_member(const WCHAR *type_name, const WCHAR *member_name, BOOL field)
+{
+    struct metadata_file_list files = {0};
+    IMetaDataDispenser *dispenser = NULL;
+    IMetaDataImport *import = NULL;
+    WCHAR default_dir[MAX_PATH], path[MAX_PATH];
+    mdTypeDef type_def;
+    mdMethodDef method_def;
+    mdFieldDef field_def;
+    BOOL found = FALSE;
+
+    if (!member_name || !get_default_metadata_dir( default_dir, ARRAY_SIZE(default_dir) )) return FALSE;
+    if (FAILED(MetaDataGetDispenser( &CLSID_CorMetaDataDispenser, &IID_IMetaDataDispenser, (void **)&dispenser )))
+        return FALSE;
+
+    collect_metadata_files( &files, default_dir );
+    qsort( files.files, files.count, sizeof(*files.files), compare_metadata_files );
+
+    if (SUCCEEDED(find_type_in_metadata( dispenser, &files, type_name, path, ARRAY_SIZE(path), &type_def,
+                                         &import )))
+    {
+        if (field)
+            found = SUCCEEDED(IMetaDataImport_FindField( import, type_def, member_name, NULL, 0, &field_def ));
+        else
+            found = SUCCEEDED(IMetaDataImport_FindMethod( import, type_def, member_name, NULL, 0, &method_def ));
+        IMetaDataImport_Release( import );
+    }
+
+    metadata_file_list_free( &files );
+    IMetaDataDispenser_Release( dispenser );
+    return found;
+}
+
+/***********************************************************************
+ *      RoGetMetaDataFile (wintypes.@)
+ *
+ * Retrieves the metadata file that describes the ABI of a type, together with a metadata reader for it and
+ * the token of its TypeDef. The caller may provide the metadata dispenser to open the file with, which is what
+ * .NET Framework does; RoMetadata.dll is used when it does not.
+ */
+HRESULT WINAPI RoGetMetaDataFile(HSTRING name, IMetaDataDispenserEx *metaDataDispenser, HSTRING *metaDataFilePath,
+                                 IMetaDataImport2 **metaDataImport, mdTypeDef *typeDefToken)
+{
+    struct metadata_file_list files = {0};
+    IMetaDataDispenser *dispenser = (IMetaDataDispenser *)metaDataDispenser, *created_dispenser = NULL;
+    const WCHAR *type_name, *cursor;
+    UINT32 name_length = 0;
+    WCHAR default_dir[MAX_PATH], path[MAX_PATH];
+    mdTypeDef type_def = mdTypeDefNil;
+    DWORD i;
+    BOOL found = FALSE;
+    HRESULT hr;
+
+    TRACE("name %s, metaDataDispenser %p, metaDataFilePath %p, metaDataImport %p, typeDefToken %p.\n",
+          debugstr_hstring(name), metaDataDispenser, metaDataFilePath, metaDataImport, typeDefToken);
+
+    if (metaDataFilePath) *metaDataFilePath = NULL;
+    if (metaDataImport) *metaDataImport = NULL;
+    if (typeDefToken) *typeDefToken = mdTypeDefNil;
+
+    if (!name) return E_INVALIDARG;
+    type_name = WindowsGetStringRawBuffer( name, &name_length );
+    /* The name has to be non-empty and free of embedded null characters. */
+    if (!name_length || wcslen( type_name ) != name_length) return E_INVALIDARG;
+    /* A dot separated name must not have an empty part before or after its last dot. */
+    if ((cursor = wcsrchr( type_name, '.' )) && (cursor == type_name || !cursor[1]))
+        return RO_E_METADATA_INVALID_TYPE_FORMAT;
+
+    if (!get_default_metadata_dir( default_dir, ARRAY_SIZE(default_dir) ))
+    {
+        WARN("no metadata directory found, cannot resolve %s\n", debugstr_hstring(name));
+        return RO_E_METADATA_NAME_NOT_FOUND;
+    }
+
+    if (!dispenser && FAILED(hr = MetaDataGetDispenser( &CLSID_CorMetaDataDispenser, &IID_IMetaDataDispenser,
+                                                        (void **)&created_dispenser )))
+        return hr;
+    if (!dispenser) dispenser = created_dispenser;
+
+    collect_metadata_files( &files, default_dir );
+    qsort( files.files, files.count, sizeof(*files.files), compare_metadata_files );
+
+    if (SUCCEEDED(hr = find_type_in_metadata( dispenser, &files, type_name, path, ARRAY_SIZE(path), &type_def,
+                                               NULL )))
+        found = TRUE;
+
+    if (found)
+    {
+        if (metaDataFilePath)
+        {
+            if (FAILED(hr = WindowsCreateString( path, wcslen( path ), metaDataFilePath ))) goto done;
+        }
+
+        /* The reader and the token are used together, so it is only opened when it is asked for. rometadata.dll
+         * of Wine implements IMetaDataImport but not IMetaDataImport2 yet, so a dispenser that does not have it
+         * cannot give a reader; the path of the file that was found is in the warning, and it is also what
+         * RoResolveNamespace() returns for the namespace, which is the call .NET Framework makes. */
+        if (metaDataImport)
+        {
+            if (FAILED(hr = open_metadata_file( dispenser, path, &IID_IMetaDataImport2, (void **)metaDataImport )))
+            {
+                WARN("no IMetaDataImport2 reader for %s, hr %#lx\n", debugstr_w(path), hr);
+                /* A failure resets the outputs, as the API contract requires. */
+                if (metaDataFilePath)
+                {
+                    WindowsDeleteString( *metaDataFilePath );
+                    *metaDataFilePath = NULL;
+                }
+                goto done;
+            }
+        }
+
+        if (typeDefToken) *typeDefToken = type_def;
+        hr = S_OK;
+    }
+    else
+    {
+        BOOL namespace_found = FALSE;
+
+        /* Distinguish a name that is an existing namespace from one that is not described at all. */
+        for (i = 0; i < files.count && !namespace_found; i++)
+            read_metadata_namespaces( dispenser, files.files[i].path, type_name, name_length, NULL,
+                                      &namespace_found, NULL );
+
+        hr = namespace_found ? RO_E_METADATA_NAME_IS_NAMESPACE : RO_E_METADATA_NAME_NOT_FOUND;
+    }
+
+done:
+    if (created_dispenser) IMetaDataDispenser_Release( created_dispenser );
+    metadata_file_list_free( &files );
+    return hr;
+}
