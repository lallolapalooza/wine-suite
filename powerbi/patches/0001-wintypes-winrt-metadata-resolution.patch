+struct string_list
+{
+    WCHAR **strings;
+    DWORD count;
+    DWORD capacity;
+};
+
+/* Copies 'length' characters of 'string', which does not have to be nul terminated. */
+static WCHAR *dup_string(const WCHAR *string, DWORD length)
+{
+    WCHAR *ret;
+
+    if (!(ret = malloc( (length + 1) * sizeof(*ret) ))) return NULL;
+    memcpy( ret, string, length * sizeof(*ret) );
+    ret[length] = 0;
+    return ret;
+}
+
+/* Appends a string to the list, ignoring duplicates. */
+static BOOL string_list_add(struct string_list *list, const WCHAR *string, DWORD length)
+{
+    WCHAR **strings;
+    DWORD capacity, i;
+
+    for (i = 0; i < list->count; i++)
+    {
+        if (wcslen( list->strings[i] ) == length && !wcsnicmp( list->strings[i], string, length ))
+            return TRUE;
+    }
+
+    if (list->count == list->capacity)
+    {
+        capacity = list->capacity ? list->capacity * 2 : 16;
+        if (!(strings = realloc( list->strings, capacity * sizeof(*strings) ))) return FALSE;
+        list->strings = strings;
+        list->capacity = capacity;
+    }
+
+    if (!(list->strings[list->count] = dup_string( string, length ))) return FALSE;
+    list->count++;
+    return TRUE;
+}
+
+static void string_list_free(struct string_list *list)
+{
+    DWORD i;
+
+    for (i = 0; i < list->count; i++) free( list->strings[i] );
+    free( list->strings );
+    memset( list, 0, sizeof(*list) );
+}
+
+/* TRUE when 'space' is the namespace 'prefix' or a namespace nested below it. The empty namespace is the root
+ * of the hierarchy, and thus contains every namespace. */
+static BOOL namespace_is_under(const WCHAR *space, DWORD space_length, const WCHAR *prefix, DWORD prefix_length)
+{
+    if (!prefix_length) return TRUE;
+    if (space_length < prefix_length || wcsnicmp( space, prefix, prefix_length )) return FALSE;
+    return space_length == prefix_length || space[prefix_length] == '.';
+}
+
+struct metadata_file
+{
+    WCHAR *path;
+    WCHAR *base_name; /* the file name without the .winmd extension */
+};
+
+struct metadata_file_list
+{
+    struct metadata_file *files;
+    DWORD count;
+    DWORD capacity;
+};
+
+static BOOL metadata_file_list_add(struct metadata_file_list *list, const WCHAR *path)
+{
+    static const WCHAR extension[] = L".winmd";
+    struct metadata_file *files;
+    const WCHAR *name;
+    WCHAR *base_name;
+    DWORD capacity, length, base_length;
+
+    if (!(name = wcsrchr( path, '\\' ))) name = wcsrchr( path, '/' );
+    if (name) name++;
+    else name = path;
+
+    length = wcslen( name );
+    if (length <= ARRAY_SIZE(extension) - 1) return FALSE;
+    if (wcsicmp( name + length - (ARRAY_SIZE(extension) - 1), extension )) return FALSE;
+    base_length = length - (ARRAY_SIZE(extension) - 1);
+
+    if (!(base_name = dup_string( name, base_length ))) return FALSE;
+
+    if (list->count == list->capacity)
+    {
+        capacity = list->capacity ? list->capacity * 2 : 16;
+        if (!(files = realloc( list->files, capacity * sizeof(*files) )))
+        {
+            free( base_name );
+            return FALSE;
+        }
+        list->files = files;
+        list->capacity = capacity;
+    }
+
+    if (!(list->files[list->count].path = dup_string( path, wcslen( path ) )))
+    {
+        free( base_name );
+        return FALSE;
+    }
+    list->files[list->count].base_name = base_name;
+    list->count++;
+    return TRUE;
+}
+
+static int __cdecl compare_metadata_files(const void *a, const void *b)
+{
+    const struct metadata_file *file_a = a, *file_b = b;
+
+    return wcsicmp( file_a->base_name, file_b->base_name );
+}
+
+static void metadata_file_list_free(struct metadata_file_list *list)
+{
+    DWORD i;
+
+    for (i = 0; i < list->count; i++)
+    {
+        free( list->files[i].path );
+        free( list->files[i].base_name );
+    }
+    free( list->files );
+    memset( list, 0, sizeof(*list) );
+}
+
+/* Adds the .winmd files of a metadata directory, or the file itself when it is a metadata file. */
+static void collect_metadata_files(struct metadata_file_list *list, const WCHAR *location)
+{
+    WIN32_FIND_DATAW data;
+    WCHAR path[MAX_PATH], pattern[MAX_PATH];
+    DWORD attributes;
+    HANDLE find;
+
+    if ((attributes = GetFileAttributesW( location )) == INVALID_FILE_ATTRIBUTES) return;
+    if (!(attributes & FILE_ATTRIBUTE_DIRECTORY))
+    {
+        metadata_file_list_add( list, location );
+        return;
+    }
+
+    if (swprintf( pattern, ARRAY_SIZE(pattern), L"%s\\*.winmd", location ) < 0) return;
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        if (swprintf( path, ARRAY_SIZE(path), L"%s\\%s", location, data.cFileName ) < 0) continue;
+        metadata_file_list_add( list, path );
+    } while (FindNextFileW( find, &data ));
+    FindClose( find );
+}
+
+/* The Windows Runtime metadata is kept in %SystemRoot%\System32\WinMetadata. A Wow64 process reaches the same
+ * files through %SystemRoot%\SysWOW64\WinMetadata when the system installs a copy there. */
+static BOOL get_default_metadata_dir(WCHAR *buffer, DWORD length)
+{
+    static const WCHAR system32[] = L"\\System32\\WinMetadata";
+    static const WCHAR syswow64[] = L"\\SysWOW64\\WinMetadata";
+    WCHAR windows_dir[MAX_PATH];
+    DWORD size;
+
+    if (!(size = GetWindowsDirectoryW( windows_dir, ARRAY_SIZE(windows_dir) )) ||
+        size >= ARRAY_SIZE(windows_dir)) return FALSE;
+
+    swprintf( buffer, length, L"%s%s", windows_dir, system32 );
+    if (GetFileAttributesW( buffer ) != INVALID_FILE_ATTRIBUTES) return TRUE;
+
+    swprintf( buffer, length, L"%s%s", windows_dir, syswow64 );
+    return GetFileAttributesW( buffer ) != INVALID_FILE_ATTRIBUTES;
+}
+
+static HRESULT open_metadata_file(IMetaDataDispenser *dispenser, const WCHAR *path, REFIID iid, void **out)
+{
+    /* ofReadOnly from the Windows SDK's cor.h; no other flag is defined for the dispenser. */
+    return IMetaDataDispenser_OpenScope( dispenser, path, 0x1, iid, (IUnknown **)out );
+}
+
+/* Retrieves the full name of a type, using 'buffer' when the name fits it and allocating one when it does not. */
+static HRESULT get_type_def_name(IMetaDataImport *import, mdTypeDef type_def, WCHAR *buffer, DWORD length,
+                                 WCHAR **name)
+{
+    ULONG needed;
+    HRESULT hr;
+
+    *name = NULL;
+    if (FAILED(hr = IMetaDataImport_GetTypeDefProps( import, type_def, buffer, length, &needed, NULL, NULL )))
+        return hr;
+    if (needed <= length)
+    {
+        *name = buffer;
+        return S_OK;
+    }
+
+    if (!(*name = malloc( needed * sizeof(**name) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = IMetaDataImport_GetTypeDefProps( import, type_def, *name, needed, NULL, NULL, NULL )))
+    {
+        free( *name );
+        *name = NULL;
+    }
+    return hr;
+}
+
+/* Walks the TypeDef table of a metadata file. Returns an error when the file cannot be read. 'namespaces',
+ * when set, collects the namespace of every type of the file. */
+static HRESULT read_metadata_namespaces(IMetaDataDispenser *dispenser, const WCHAR *path, const WCHAR *name,
+                                        DWORD name_length, BOOL *type_found, BOOL *namespace_found,
+                                        struct string_list *namespaces)
+{
+    IMetaDataImport *import;
+    HCORENUM enumerator = NULL;
+    mdTypeDef type_def;
+    ULONG count;
+    WCHAR buffer[256], *full_name;
+    HRESULT hr;
+
+    if (type_found) *type_found = FALSE;
+    if (namespace_found) *namespace_found = FALSE;
+
+    if (FAILED(hr = open_metadata_file( dispenser, path, &IID_IMetaDataImport, (void **)&import ))) return hr;
+
+    while (!FAILED(hr = IMetaDataImport_EnumTypeDefs( import, &enumerator, &type_def, 1, &count )) && count)
+    {
+        const WCHAR *cursor;
+        DWORD namespace_length;
+
+        if (FAILED(hr = get_type_def_name( import, type_def, buffer, ARRAY_SIZE(buffer), &full_name ))) break;
+
+        if ((cursor = wcsrchr( full_name, '.' ))) namespace_length = cursor - full_name;
+        else namespace_length = 0;
+
+        if (type_found && !*type_found && !wcsicmp( full_name, name )) *type_found = TRUE;
+        if (namespace_found && !*namespace_found && namespace_is_under( full_name, namespace_length, name,
+                                                                       name_length ))
+            *namespace_found = TRUE;
+        if (namespaces && namespace_length)
+            string_list_add( namespaces, full_name, namespace_length );
+
+        if (full_name != buffer) free( full_name );
+    }
+
+    IMetaDataImport_CloseEnum( import, enumerator );
+    IMetaDataImport_Release( import );
+    return hr;
+}
+
+/* Adds the direct children of a namespace. Windows answers this from the metadata directory itself: a child is
+ * a namespace that has a metadata file of its own (the 18 namespaces Windows.AI.winmd ... Windows.Web.winmd
+ * give "Windows"), not a namespace that is only declared inside the types of another file (the 8 namespaces
+ * declared in Windows.Storage.winmd are not reported for "Windows.Storage"), and the names are relative to the
+ * requested namespace. The contract files are not namespaces of their own - Windows.Foundation.winmd and
+ * Windows.Foundation.FoundationContract.winmd describe the same types - which is why they are skipped. */
+static void add_child_namespaces(const struct metadata_file_list *files, const WCHAR *name, DWORD name_length,
+                                 struct string_list *children)
+{
+    static const WCHAR contract[] = L"Contract";
+    DWORD i;
+
+    for (i = 0; i < files->count; i++)
+    {
+        const WCHAR *base_name = files->files[i].base_name, *child;
+        DWORD length = wcslen( base_name ), child_length;
+
+        if (length <= name_length || !namespace_is_under( base_name, length, name, name_length )) continue;
+        child = base_name + name_length + 1;
+        child_length = length - name_length - 1;
+        if (wcschr( child, '.' )) continue; /* a namespace nested deeper than a direct child */
+        if (child_length > ARRAY_SIZE(contract) - 1 &&
+            !wcsicmp( child + child_length - (ARRAY_SIZE(contract) - 1), contract ))
+            continue;
+
+        string_list_add( children, child, child_length );
+    }
+}
+
+static HRESULT create_hstring_array(const struct string_list *list, DWORD *count, HSTRING **strings)
+{
+    HSTRING *array;
+    DWORD i;
+    HRESULT hr;
+
+    *strings = NULL;
+    if (count) *count = 0;
+    if (!list->count) return S_OK;
+
+    if (!(array = CoTaskMemAlloc( list->count * sizeof(*array) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < list->count; i++)
+    {
+        if (FAILED(hr = WindowsCreateString( list->strings[i], wcslen( list->strings[i] ), &array[i] )))
+        {
+            while (i) WindowsDeleteString( array[--i] );
+            CoTaskMemFree( array );
+            return hr;
+        }
+    }
+
+    *strings = array;
+    if (count) *count = list->count;
+    return S_OK;
+}
