+
+/******************************************************************************
+ *              DeriveAppContainerSidFromAppContainerName   (USERENV.@)
+ *
+ * Derive the package SID of an AppContainer from its name.
+ *
+ * Windows builds "S-1-15-2-<x0>-...-<x6>" out of the name: the name is
+ * lowercased, hashed with SHA-256 as UTF-16, and the first 28 bytes of the
+ * hash become seven little-endian 32-bit subauthorities (the remaining word is
+ * dropped).  Verified against the SID Windows 11 derives for
+ * Microsoft.Windows.ShellExperienceHost_cw5n1h2txyewy, which is
+ * S-1-15-2-155514346-2573954481-755741238-1654018636-1233331829-3075935687-2861478708.
+ * The returned SID is allocated on the process heap so that it can be freed
+ * with FreeSid, as documented.
+ */
+HRESULT WINAPI DeriveAppContainerSidFromAppContainerName( PCWSTR name, PSID *sid )
+{
+    static const SID_IDENTIFIER_AUTHORITY app_authority = { SECURITY_APP_PACKAGE_AUTHORITY };
+    UNICODE_STRING name_us, name_lower;
+    BCRYPT_ALG_HANDLE alg = NULL;
+    BCRYPT_HASH_HANDLE hash = NULL;
+    UCHAR digest[32];
+    NTSTATUS status;
+    SID *ret;
+    BOOL ok;
+
+    TRACE( "name %s, sid %p\n", debugstr_w(name), sid );
+
+    if (!name || !sid) return E_INVALIDARG;
+    *sid = NULL;
+
+    RtlInitUnicodeString( &name_us, name );
+    if ((status = RtlDowncaseUnicodeString( &name_lower, &name_us, TRUE )))
+        return HRESULT_FROM_NT( status );
+
+    ok = !BCryptOpenAlgorithmProvider( &alg, BCRYPT_SHA256_ALGORITHM, NULL, 0 ) &&
+         !BCryptCreateHash( alg, &hash, NULL, 0, NULL, 0, 0 ) &&
+         !BCryptHashData( hash, (UCHAR *)name_lower.Buffer, name_lower.Length, 0 ) &&
+         !BCryptFinishHash( hash, digest, sizeof(digest), 0 );
+    RtlFreeUnicodeString( &name_lower );
+    if (hash) BCryptDestroyHash( hash );
+    if (alg) BCryptCloseAlgorithmProvider( alg, 0 );
+    if (!ok) return E_FAIL;
+
+    ret = HeapAlloc( GetProcessHeap(), 0, RtlLengthRequiredSid( SECURITY_APP_PACKAGE_RID_COUNT ));
+    if (!ret) return E_OUTOFMEMORY;
+
+    ret->Revision = SID_REVISION;
+    ret->IdentifierAuthority = app_authority;
+    ret->SubAuthorityCount = SECURITY_APP_PACKAGE_RID_COUNT;
+    ret->SubAuthority[0] = SECURITY_APP_PACKAGE_BASE_RID;
+    memcpy( ret->SubAuthority + 1, digest, (SECURITY_APP_PACKAGE_RID_COUNT - 1) * sizeof(DWORD) );
+
+    *sid = ret;
+    return S_OK;
+}
