+/* Windows derives an AppContainer package SID from the name: lowercase it,
+ * hash it as UTF-16 with SHA-256, and use the first 28 bytes of the hash as
+ * seven little-endian 32-bit subauthorities of S-1-15-2-* (the eighth word is
+ * dropped).  The expected value below is what Windows 11 returns for
+ * Microsoft.Windows.ShellExperienceHost_cw5n1h2txyewy. */
+static void test_DeriveAppContainerSidFromAppContainerName(void)
+{
+    static const SID_IDENTIFIER_AUTHORITY app_authority = { SECURITY_APP_PACKAGE_AUTHORITY };
+    static const DWORD expected[] =
+    {
+        155514346, 2573954481, 755741238, 1654018636, 1233331829, 3075935687, 2861478708
+    };
+    PSID sid = NULL, sid2 = NULL;
+    SID *s;
+    HRESULT hr;
+    UINT i;
+
+    ok( pDeriveAppContainerSidFromAppContainerName != NULL,
+        "DeriveAppContainerSidFromAppContainerName is not exported\n" );
+    if (!pDeriveAppContainerSidFromAppContainerName) return;
+
+    hr = pDeriveAppContainerSidFromAppContainerName( L"Microsoft.Windows.ShellExperienceHost_cw5n1h2txyewy", &sid );
+    ok( hr == S_OK, "got hr %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        s = sid;
+        ok( s->Revision == SID_REVISION, "got revision %u\n", s->Revision );
+        ok( !memcmp( &s->IdentifierAuthority, &app_authority, sizeof(app_authority) ),
+            "unexpected authority\n" );
+        ok( s->SubAuthorityCount == SECURITY_APP_PACKAGE_RID_COUNT, "got %u\n", s->SubAuthorityCount );
+        if (s->SubAuthorityCount == SECURITY_APP_PACKAGE_RID_COUNT)
+        {
+            ok( s->SubAuthority[0] == SECURITY_APP_PACKAGE_BASE_RID, "got %lu\n", s->SubAuthority[0] );
+            for (i = 0; i < ARRAY_SIZE(expected); i++)
+                ok( s->SubAuthority[i + 1] == expected[i],
+                    "subauthority %u: got %lu, expected %lu\n", i, s->SubAuthority[i + 1], expected[i] );
+        }
+
+        /* the name is lowercased before hashing, so case must not matter */
+        hr = pDeriveAppContainerSidFromAppContainerName( L"MICROSOFT.WINDOWS.SHELLEXPERIENCEHOST_CW5N1H2TXYEWY", &sid2 );
+        ok( hr == S_OK, "got hr %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            ok( EqualSid( sid, sid2 ), "case-insensitive names must derive the same SID\n" );
+            FreeSid( sid2 );
+        }
+        FreeSid( sid );
+    }
+
+    hr = pDeriveAppContainerSidFromAppContainerName( NULL, &sid );
+    ok( hr == E_INVALIDARG, "got hr %#lx\n", hr );
+    hr = pDeriveAppContainerSidFromAppContainerName( L"test", NULL );
+    ok( hr == E_INVALIDARG, "got hr %#lx\n", hr );
+}
+
 START_TEST(userenv)
 {
     pIsWow64Process = (void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "IsWow64Process");
+    pDeriveAppContainerSidFromAppContainerName =
+        (void *)GetProcAddress(GetModuleHandleA("userenv.dll"), "DeriveAppContainerSidFromAppContainerName");
 
     test_create_env();
     test_get_profiles_dir();
     test_get_user_profile_dir();
+    test_DeriveAppContainerSidFromAppContainerName();
 }
