+/* A caller keeps the output buffer it set up: the package may hand back a buffer of its own, and it hands
+ * back none at all when it has no token to send, so take the token out of whatever came back and put this
+ * test's buffer back into the descriptor.  (ISC_REQ_ALLOCATE_MEMORY is not used here, and the token is copied
+ * out either way.) */
+static void keep_own_output( SecBuffer *buf, void *own_buffer, ULONG size )
+{
+    ULONG len = buf->cbBuffer;
+
+    if (buf->pvBuffer == own_buffer) return;
+    if (len > size) len = size;
+    if (len && buf->pvBuffer) memcpy( own_buffer, buf->pvBuffer, len );
+    buf->pvBuffer = own_buffer;
+}
