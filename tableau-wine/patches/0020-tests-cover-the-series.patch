+/* GetProcessUserModeExceptionPolicy/SetProcessUserModeExceptionPolicy are only
+ * exported on Windows 7 and later, so they are resolved dynamically. */
+static void test_UserModeExceptionPolicy(void)
+{
+    DWORD flags, old;
+
+    ok(pGetProcessUserModeExceptionPolicy != NULL, "GetProcessUserModeExceptionPolicy is not exported\n");
+    ok(pSetProcessUserModeExceptionPolicy != NULL, "SetProcessUserModeExceptionPolicy is not exported\n");
+    if (!pGetProcessUserModeExceptionPolicy || !pSetProcessUserModeExceptionPolicy) return;
+
+    if (!pGetProcessUserModeExceptionPolicy(&old))
+    {
+        ok(0, "failed to query the current exception policy, error %lu\n", GetLastError());
+        return;
+    }
+
+    SetLastError(0xdeadbeef);
+    ok(!pGetProcessUserModeExceptionPolicy(NULL), "expected failure\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "expected ERROR_INVALID_PARAMETER, got %lu\n", GetLastError());
+
+    flags = 0xdeadbeef;
+    ok(pSetProcessUserModeExceptionPolicy(PROCESS_CALLBACK_FILTER_ENABLED),
+       "SetProcessUserModeExceptionPolicy failed, error %lu\n", GetLastError());
+    ok(pGetProcessUserModeExceptionPolicy(&flags), "GetProcessUserModeExceptionPolicy failed, error %lu\n", GetLastError());
+    ok(flags == PROCESS_CALLBACK_FILTER_ENABLED, "expected %#x, got %#lx\n", PROCESS_CALLBACK_FILTER_ENABLED, flags);
+
