+/* Tests WTD_CHOICE_BLOB: the signed object is a PKCS#7 message held in memory.
+ * The signature embedded in SelfSignedFile32 is used as the blob, so the
+ * expected trust status is the same as when that file is verified. */
+static void test_wintrust_blob(void)
+{
+    static GUID generic_action_v2 = WINTRUST_ACTION_GENERIC_VERIFY_V2;
+    SAFE_PROVIDER_FUNCTIONS funcs = { sizeof(SAFE_PROVIDER_FUNCTIONS), 0 };
+    WINTRUST_BLOB_INFO blob = { sizeof(blob), { 0 } };
+    WINTRUST_DATA data = { sizeof(data), 0 };
+    CRYPT_PROVIDER_DATA *prov;
+    IMAGE_DOS_HEADER dos;
+    IMAGE_NT_HEADERS32 nt;
+    DWORD sig_off, sig_len;
+    LONG status;
+
+    if (!WintrustLoadFunctionPointers(&generic_action_v2,
+     (CRYPT_PROVIDER_FUNCTIONS *)&funcs) || !funcs.pfnObjectTrust)
+    {
+        skip("the generic verify trust provider is not registered\n");
+        return;
+    }
+
+    memcpy(&dos, SelfSignedFile32, sizeof(dos));
+    memcpy(&nt, SelfSignedFile32 + dos.e_lfanew, sizeof(nt));
+    sig_off = nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_SECURITY].VirtualAddress;
+    sig_len = nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_SECURITY].Size;
+    ok(sig_off + sig_len <= sizeof(SelfSignedFile32),
+     "unexpected signature location %#lx/%#lx\n", sig_off, sig_len);
+    if (sig_off + sig_len > sizeof(SelfSignedFile32))
+        return;
+
+    blob.pbMemObject = (BYTE *)SelfSignedFile32 + sig_off + sizeof(WIN_CERTIFICATE);
+    blob.cbMemObject = sig_len - sizeof(WIN_CERTIFICATE);
+
+    data.dwUIChoice = WTD_UI_NONE;
+    data.fdwRevocationChecks = WTD_REVOKE_NONE;
+    data.dwUnionChoice = WTD_CHOICE_BLOB;
+    data.pBlob = &blob;
+    data.dwStateAction = WTD_STATEACTION_VERIFY;
+    status = WinVerifyTrust(NULL, &generic_action_v2, &data);
+    ok(status != ERROR_INVALID_PARAMETER,
+     "WTD_CHOICE_BLOB is not supported, got %#lx\n", status);
+    /* Same trust status as verifying the file the signature came from: the
+     * signing certificate is not trusted. */
+    ok(status == CERT_E_UNTRUSTEDROOT || status == CERT_E_CHAINING,
+     "expected CERT_E_UNTRUSTEDROOT or CERT_E_CHAINING, got %#lx\n", status);
+
+    prov = WTHelperProvDataFromStateData(data.hWVTStateData);
+    ok(prov != NULL, "got NULL provider data\n");
+    if (prov)
+    {
+        /* The in-memory PKCS#7 message was decoded and its signer loaded. */
+        ok(prov->csSigners == 1, "expected 1 signer, got %lu\n", prov->csSigners);
+        if (prov->csSigners == 1)
+            ok(prov->pasSigners[0].psSigner != NULL,
+             "expected a signer info\n");
+    }
+
+    data.dwStateAction = WTD_STATEACTION_CLOSE;
+    status = WinVerifyTrust(NULL, &generic_action_v2, &data);
+    ok(status == S_OK, "closing the state failed: %#lx\n", status);
+}
