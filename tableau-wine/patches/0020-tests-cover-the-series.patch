+/* Chromium's network change notifier asks the Network Location Awareness namespace whether the
+ * machine has a network connection at all (WSALookupServiceBeginW(NS_NLA) followed by
+ * WSALookupServiceNextW).  Windows answers these lookups; here they must succeed as well and
+ * report one network when an adapter is up, WSA_E_NO_MORE otherwise. */
+static void test_WSALookupService_NLA(void)
+{
+    char buffer[4096];
+    WSAQUERYSETW *qs = (WSAQUERYSETW *)buffer;
+    WSAQUERYSETA *qsa = (WSAQUERYSETA *)buffer;
+    BOOL connected = test_have_network_connection();
+    HANDLE handle;
+    DWORD size;
+    int ret, count;
+
+    memset( buffer, 0, sizeof(buffer) );
+    qs->dwSize = sizeof(*qs);
+    qs->dwNameSpace = NS_NLA;
+    handle = NULL;
+
+    ret = WSALookupServiceBeginW( qs, LUP_RETURN_ALL, &handle );
+    ok( !ret, "WSALookupServiceBeginW(NS_NLA) failed with error %lu\n", WSAGetLastError() );
+    if (ret) return;
+    ok( handle != NULL, "handle was not set\n" );
+
+    for (count = 0; count < 32; count++)
+    {
+        memset( qs, 0, sizeof(*qs) );
+        size = sizeof(buffer);
+        if (WSALookupServiceNextW( handle, LUP_RETURN_NAME, &size, qs ) == SOCKET_ERROR) break;
+        ok( qs->dwNameSpace == NS_NLA, "got namespace %lu\n", qs->dwNameSpace );
+        ok( !!qs->lpszServiceInstanceName, "no service instance name\n" );
+    }
+    ok( count < 32, "too many results\n" );
+    ok( WSAGetLastError() == WSA_E_NO_MORE, "got error %lu\n", WSAGetLastError() );
+    if (connected)
+        ok( count > 0, "no network reported although an adapter is up\n" );
+    else
+        ok( !count, "network reported although no adapter is up\n" );
+
+    ok( !WSALookupServiceEnd( handle ), "WSALookupServiceEnd failed unexpectedly\n" );
+
+    /* the same through the ANSI entry points */
+    memset( buffer, 0, sizeof(buffer) );
+    qsa->dwSize = sizeof(*qsa);
+    qsa->dwNameSpace = NS_NLA;
+    handle = NULL;
+
+    ret = WSALookupServiceBeginA( qsa, LUP_RETURN_ALL, &handle );
+    ok( !ret, "WSALookupServiceBeginA(NS_NLA) failed with error %lu\n", WSAGetLastError() );
+    if (!ret)
+    {
+        memset( qsa, 0, sizeof(*qsa) );
+        size = sizeof(buffer);
+        ret = WSALookupServiceNextA( handle, LUP_RETURN_NAME, &size, qsa );
+        if (connected)
+        {
+            ok( !ret, "WSALookupServiceNextA failed with error %lu\n", WSAGetLastError() );
+            if (!ret)
+            {
+                ok( qsa->dwNameSpace == NS_NLA, "got namespace %lu\n", qsa->dwNameSpace );
+                ok( !!qsa->lpszServiceInstanceName, "no service instance name\n" );
+            }
+        }
+        else
+            ok( ret == SOCKET_ERROR && WSAGetLastError() == WSA_E_NO_MORE,
+                "got error %lu\n", WSAGetLastError() );
+
+        ok( !WSALookupServiceEnd( handle ), "WSALookupServiceEnd failed unexpectedly\n" );
+    }
+}
