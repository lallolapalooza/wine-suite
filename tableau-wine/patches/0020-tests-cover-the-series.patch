+static void test_reg_load_app_key_regf(void)
+{
+    char hivefilepath[MAX_PATH];
+    BYTE hive[REGF_HBIN_OFF + REGF_HBIN_SIZE];
+    BYTE output[sizeof(REGF_TEST_STRING)];
+    HKEY appkey = NULL, subkey = NULL;
+    DWORD ret, type, size, value, written;
+    HANDLE file;
+
+    build_regf_hive(hive);
+
+    if (GetTempPathA(MAX_PATH, hivefilepath) + strlen("wine_reg_appkey.hiv") >= MAX_PATH)
+    {
+        skip("temp path is too long\n");
+        return;
+    }
+    strcat(hivefilepath, "wine_reg_appkey.hiv");
+
+    file = CreateFileA(hivefilepath, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "failed to create %s, error %lu\n", hivefilepath, GetLastError());
+    if (file == INVALID_HANDLE_VALUE) return;
+    ok(WriteFile(file, hive, sizeof(hive), &written, NULL) && written == sizeof(hive),
+       "failed to write %s, error %lu\n", hivefilepath, GetLastError());
+    CloseHandle(file);
+
+    ret = RegLoadAppKeyA(hivefilepath, &appkey, KEY_READ | KEY_WRITE, 0, 0);
+    ok(ret == ERROR_SUCCESS, "RegLoadAppKeyA failed, error %lu\n", ret);
+
+    value = 0;
+    size = sizeof(value);
+    type = 0;
+    ret = RegQueryValueExA(appkey, "Count", NULL, &type, (BYTE *)&value, &size);
+    ok(ret == ERROR_SUCCESS, "RegQueryValueExA(Count) failed, error %lu\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        ok(type == REG_DWORD, "unexpected type %lu\n", type);
+        ok(size == sizeof(value), "unexpected size %lu\n", size);
+        ok(value == REGF_TEST_DWORD, "unexpected value %#lx\n", value);
+    }
+
+    ret = RegOpenKeyExA(appkey, "Sub", 0, KEY_READ, &subkey);
+    ok(ret == ERROR_SUCCESS, "RegOpenKeyExA(Sub) failed, error %lu\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        memset(output, 0xcc, sizeof(output));
+        size = sizeof(output);
+        type = 0;
+        ret = RegQueryValueExA(subkey, "Label", NULL, &type, output, &size);
+        ok(ret == ERROR_SUCCESS, "RegQueryValueExA(Label) failed, error %lu\n", ret);
+        if (ret == ERROR_SUCCESS)
+        {
+            ok(type == REG_SZ, "unexpected type %lu\n", type);
+            ok(size == sizeof(REGF_TEST_STRING), "unexpected size %lu\n", size);
+            ok(!memcmp(output, REGF_TEST_STRING, sizeof(REGF_TEST_STRING)),
+               "unexpected data %s\n", output);
+        }
+        RegCloseKey(subkey);
+    }
+
+    /* values can also be created on the loaded key */
+    value = 0xcafebabe;
+    ret = RegSetValueExA(appkey, "NewValue", 0, REG_DWORD, (const BYTE *)&value, sizeof(value));
+    ok(ret == ERROR_SUCCESS, "RegSetValueExA(NewValue) failed, error %lu\n", ret);
+
+    value = 0;
+    size = sizeof(value);
+    ret = RegQueryValueExA(appkey, "NewValue", NULL, &type, (BYTE *)&value, &size);
+    ok(ret == ERROR_SUCCESS, "RegQueryValueExA(NewValue) failed, error %lu\n", ret);
+    if (ret == ERROR_SUCCESS)
+    {
+        ok(type == REG_DWORD, "unexpected type %lu\n", type);
+        ok(value == 0xcafebabe, "unexpected value %#lx\n", value);
+    }
+
+    ret = RegCloseKey(appkey);
+    ok(ret == ERROR_SUCCESS, "RegCloseKey failed, error %lu\n", ret);
+
+    file = CreateFileA(hivefilepath, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                       OPEN_EXISTING, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "hive file is still in use, error %lu\n", GetLastError());
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+    ok(DeleteFileA(hivefilepath), "failed to delete %s, error %lu\n", hivefilepath, GetLastError());
+}
