+static void test_ImpersonateAnonymousToken(void)
+{
+    SECURITY_IMPERSONATION_LEVEL level;
+    TOKEN_PRIMARY_GROUP *primary_group;
+    TOKEN_GROUPS *groups;
+    TOKEN_USER *user;
+    LPWSTR sid_str = NULL;
+    HANDLE token, thread;
+    TOKEN_TYPE type;
+    NTSTATUS status;
+    DWORD size;
+
+    thread = GetCurrentThread();
+
+    status = NtImpersonateAnonymousToken( NULL );
+    ok( status == STATUS_INVALID_HANDLE || broken(status == STATUS_NOT_IMPLEMENTED),
+        "NtImpersonateAnonymousToken(NULL) returned %#lx\n", status );
+
+    status = NtImpersonateAnonymousToken( (HANDLE)0x1234 );
+    ok( status == STATUS_INVALID_HANDLE || broken(status == STATUS_NOT_IMPLEMENTED),
+        "NtImpersonateAnonymousToken(0x1234) returned %#lx\n", status );
+
+    /* The call gives the thread the anonymous logon token - what a server does before it talks to a
+     * client it has not authenticated, and what the listener of Power BI's Analysis Services engine
+     * needs before it accepts its port as up. */
+    status = NtImpersonateAnonymousToken( thread );
+    ok( status == STATUS_SUCCESS, "NtImpersonateAnonymousToken returned %#lx\n", status );
+    if (status) return;
+
+    if (!OpenThreadToken( thread, TOKEN_QUERY, TRUE, &token ))
+    {
+        ok( 0, "OpenThreadToken failed: %lu\n", GetLastError() );
+        RevertToSelf();
+        return;
+    }
+
+    size = sizeof(type);
+    ok( GetTokenInformation( token, TokenType, &type, size, &size ),
+        "GetTokenInformation(TokenType) failed: %lu\n", GetLastError() );
+    ok( type == TokenImpersonation, "got %u\n", type );
+
+    size = sizeof(level);
+    ok( GetTokenInformation( token, TokenImpersonationLevel, &level, size, &size ),
+        "GetTokenInformation(TokenImpersonationLevel) failed: %lu\n", GetLastError() );
+    ok( level == SecurityImpersonation, "got %u\n", level );
+
+    size = 0;
+    ok( !GetTokenInformation( token, TokenUser, NULL, 0, &size ) && GetLastError() == ERROR_INSUFFICIENT_BUFFER,
+        "expected ERROR_INSUFFICIENT_BUFFER, got %lu\n", GetLastError() );
+    if ((user = HeapAlloc( GetProcessHeap(), 0, size )))
+    {
+        ok( GetTokenInformation( token, TokenUser, user, size, &size ),
+            "GetTokenInformation(TokenUser) failed: %lu\n", GetLastError() );
+        ok( ConvertSidToStringSidW( user->User.Sid, &sid_str ),
+            "ConvertSidToStringSidW failed: %lu\n", GetLastError() );
+        if (sid_str)
+        {
+            ok( !wcscmp( sid_str, L"S-1-5-7" ), "got %s\n", wine_dbgstr_w(sid_str) );
+            LocalFree( sid_str );
+            sid_str = NULL;
+        }
+        HeapFree( GetProcessHeap(), 0, user );
+    }
+
+    size = 0;
+    GetTokenInformation( token, TokenPrimaryGroup, NULL, 0, &size );
+    if ((primary_group = HeapAlloc( GetProcessHeap(), 0, size )))
+    {
+        ok( GetTokenInformation( token, TokenPrimaryGroup, primary_group, size, &size ),
+            "GetTokenInformation(TokenPrimaryGroup) failed: %lu\n", GetLastError() );
+        ok( ConvertSidToStringSidW( primary_group->PrimaryGroup, &sid_str ),
+            "ConvertSidToStringSidW failed: %lu\n", GetLastError() );
+        if (sid_str)
+        {
+            ok( !wcscmp( sid_str, L"S-1-1-0" ), "got %s\n", wine_dbgstr_w(sid_str) );
+            LocalFree( sid_str );
+            sid_str = NULL;
+        }
+        HeapFree( GetProcessHeap(), 0, primary_group );
+    }
+
+    size = 0;
+    GetTokenInformation( token, TokenGroups, NULL, 0, &size );
+    if ((groups = HeapAlloc( GetProcessHeap(), 0, size )))
+    {
+        ok( GetTokenInformation( token, TokenGroups, groups, size, &size ),
+            "GetTokenInformation(TokenGroups) failed: %lu\n", GetLastError() );
+        ok( groups->GroupCount == 1, "got %lu\n", groups->GroupCount );
+        if (groups->GroupCount == 1)
+        {
+            ok( ConvertSidToStringSidW( groups->Groups[0].Sid, &sid_str ),
+                "ConvertSidToStringSidW failed: %lu\n", GetLastError() );
+            if (sid_str)
+            {
+                ok( !wcscmp( sid_str, L"S-1-1-0" ), "got %s\n", wine_dbgstr_w(sid_str) );
+                LocalFree( sid_str );
+            }
+        }
+        HeapFree( GetProcessHeap(), 0, groups );
+    }
+
+    ok( CloseHandle( token ), "CloseHandle failed: %lu\n", GetLastError() );
+
+    /* the wrapper an application calls */
+    SetLastError( 0xdeadbeef );
+    ok( ImpersonateAnonymousToken( thread ), "ImpersonateAnonymousToken failed: %lu\n", GetLastError() );
+    ok( RevertToSelf(), "RevertToSelf failed: %lu\n", GetLastError() );
+    ok( !OpenThreadToken( thread, TOKEN_QUERY, TRUE, &token ),
+        "expected the thread token to be gone after RevertToSelf\n" );
+}
+
+START_TEST(impersonate)
+{
+    test_ImpersonateAnonymousToken();
+}
