+/* Qt's touch handler (qwindowspointerhandler.cpp) calls
+ * SkipPointerFrameMessages after it has consumed a frame of WM_POINTER
+ * messages.  Wine keeps no per-frame queue, so the call has nothing to skip
+ * but must still report success and must never abort the process. */
+static void test_SkipPointerFrameMessages(void)
+{
+    ok( pSkipPointerFrameMessages != NULL, "SkipPointerFrameMessages is not exported\n" );
+    if (!pSkipPointerFrameMessages) return;
+
+    SetLastError( 0xdeadbeef );
+    ok( pSkipPointerFrameMessages( 1 ), "SkipPointerFrameMessages failed: %lu\n", GetLastError() );
+
+    /* an unknown pointer id must not crash either */
+    pSkipPointerFrameMessages( 0xdeadbeef );
+}
+
 START_TEST(input)
