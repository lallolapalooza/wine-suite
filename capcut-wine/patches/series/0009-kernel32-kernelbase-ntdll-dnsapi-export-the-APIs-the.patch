+
+/***********************************************************************
+ *           RtlAreLongPathsEnabled   (NTDLL.@)
+ *
+ * Windows reports whether long paths are enabled for the process, which it takes from the
+ * LongPathsEnabled registry policy; several runtimes (and AcPal) probe for this export.
+ */
+BOOLEAN WINAPI RtlAreLongPathsEnabled(void)
+{
+    static const WCHAR file_system_key[] =
+        L"\\Registry\\Machine\\SYSTEM\\CurrentControlSet\\Control\\FileSystem";
+    static const WCHAR long_paths_value[] = L"LongPathsEnabled";
+    RTL_QUERY_REGISTRY_TABLE table[2];
+    ULONG enabled = 0;
+
+    memset( table, 0, sizeof(table) );
+    table[0].Flags = RTL_QUERY_REGISTRY_DIRECT;
+    table[0].Name = long_paths_value;
+    table[0].EntryContext = &enabled;
+    table[0].DefaultType = REG_DWORD;
+    table[0].DefaultData = &enabled;
+    table[0].DefaultLength = sizeof(enabled);
+
+    if (RtlQueryRegistryValues( RTL_REGISTRY_ABSOLUTE, file_system_key, table, NULL, NULL ))
+        return FALSE;
+    return enabled != 0;
+}
