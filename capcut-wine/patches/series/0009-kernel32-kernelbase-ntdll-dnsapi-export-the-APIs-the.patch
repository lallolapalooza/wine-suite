diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index 25b3f4f..fc92c5b 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -1935,3 +1935,37 @@ DWORD WINAPI PssCaptureSnapshot( HANDLE hprocess, PSS_CAPTURE_FLAGS flags, DWORD
     FIXME( "(%p %u %lu %p)\n", hprocess , flags, ctx_flags, handle );
     return ERROR_NOT_FOUND;
 }
+
+static ULONG user_mode_exception_policy;
+
+/***********************************************************************
+ *           GetProcessUserModeExceptionPolicy   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH GetProcessUserModeExceptionPolicy( ULONG *flags )
+{
+    if (!flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *flags = user_mode_exception_policy;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           SetProcessUserModeExceptionPolicy   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH SetProcessUserModeExceptionPolicy( ULONG flags )
+{
+    user_mode_exception_policy = flags;
+    return TRUE;
+}
+
+/***********************************************************************
+ *           IsUserCetAvailableInEnvironment   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH IsUserCetAvailableInEnvironment( ULONG env )
+{
+    /* Wine provides no CET-enabled environment (USER_CET_ENVIRONMENT_*) */
+    return FALSE;
+}
diff --git a/dlls/kernelbase/thread.c b/dlls/kernelbase/thread.c
index 92ef073..c7aa1f7 100644
--- a/dlls/kernelbase/thread.c
+++ b/dlls/kernelbase/thread.c
@@ -1271,6 +1271,19 @@ PVOID WINAPI DECLSPEC_HOTPATCH FlsGetValue( DWORD index )
 }
 
 
+/***********************************************************************
+ *           FlsGetValue2   (kernelbase.@)
+ */
+PVOID WINAPI DECLSPEC_HOTPATCH FlsGetValue2( DWORD index )
+{
+    void *data;
+
+    /* undocumented kernel32 export present since Windows 8, used by several runtimes
+     * (Chromium/Edge check for it through GetProcAddress); behaves like FlsGetValue */
+    if (!set_ntstatus( RtlFlsGetValue( index, &data ))) return NULL;
+    SetLastError( ERROR_SUCCESS );
+    return data;
+}
 /***********************************************************************
  *           FlsSetValue   (kernelbase.@)
  */
