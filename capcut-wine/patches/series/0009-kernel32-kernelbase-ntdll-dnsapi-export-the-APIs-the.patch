+/***********************************************************************
+ *           DnsIsZtEnabled   (dnsapi.@)
+ *
+ * "Zero Trust DNS" is a Windows 11 feature (DnsIsZtEnabled); Chromium/Edge probe for it.
+ */
+BOOL WINAPI DnsIsZtEnabled( void )
+{
+    return FALSE;
+}
