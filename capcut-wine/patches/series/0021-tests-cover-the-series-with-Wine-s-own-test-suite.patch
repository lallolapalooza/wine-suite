+static void test_converttobool(void)
+{
+    HRESULT hr;
+    VARIANT_BOOL dst;
+    BYTE src[sizeof(VARIANT)];  /* assuming that VARIANT is larger than all the types used in src */
+    DBSTATUS dst_status;
+    DBLENGTH dst_len;
+
+    dst_len = 0x1234;
+    dst = VARIANT_FALSE;
+    V_VT((VARIANT*)src) = VT_BOOL;
+    V_BOOL((VARIANT*)src) = VARIANT_TRUE;
+    hr = IDataConvert_DataConvert(convert, DBTYPE_VARIANT, DBTYPE_BOOL, 0, &dst_len, src, &dst, sizeof(dst), 0, &dst_status, 0, 0, 0);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    ok(dst_status == DBSTATUS_S_OK, "got %08lx\n", dst_status);
+    ok(dst_len == sizeof(dst), "got %Id\n", dst_len);
+    ok(dst == VARIANT_TRUE, "got %04x\n", (unsigned)dst);
+
+    dst_len = 0x1234;
+    dst = VARIANT_TRUE;
+    V_VT((VARIANT*)src) = VT_I4;
+    V_I4((VARIANT*)src) = 0;
+    hr = IDataConvert_DataConvert(convert, DBTYPE_VARIANT, DBTYPE_BOOL, 0, &dst_len, src, &dst, sizeof(dst), 0, &dst_status, 0, 0, 0);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    ok(dst_status == DBSTATUS_S_OK, "got %08lx\n", dst_status);
+    ok(dst_len == sizeof(dst), "got %Id\n", dst_len);
+    ok(dst == VARIANT_FALSE, "got %04x\n", (unsigned)dst);
+
+    dst_len = 0x1234;
+    dst = VARIANT_FALSE;
+    V_I4((VARIANT*)src) = 1;
+    hr = IDataConvert_DataConvert(convert, DBTYPE_VARIANT, DBTYPE_BOOL, 0, &dst_len, src, &dst, sizeof(dst), 0, &dst_status, 0, 0, 0);
+    ok(hr == S_OK, "got %08lx\n", hr);
+    ok(dst_status == DBSTATUS_S_OK, "got %08lx\n", dst_status);
+    ok(dst_len == sizeof(dst), "got %Id\n", dst_len);
+    ok(dst == VARIANT_TRUE, "got %04x\n", (unsigned)dst);
 }
 
