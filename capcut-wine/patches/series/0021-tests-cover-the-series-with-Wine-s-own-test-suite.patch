+/* The resolution calls answer from %SystemRoot%\System32\WinMetadata (SysWOW64\WinMetadata for a Wow64
+ * process), and there is nothing to resolve when those files are not installed - a plain Wine prefix has
+ * no Windows metadata. */
+static BOOL have_metadata_dir(void)
+{
+    const WCHAR *subdir = is_wow64 ? L"\\SysWOW64\\WinMetadata" : L"\\System32\\WinMetadata";
+    WCHAR path[MAX_PATH], windows_dir[MAX_PATH];
+
+    if (!GetWindowsDirectoryW( windows_dir, ARRAY_SIZE(windows_dir) )) return FALSE;
+    if (lstrlenW( windows_dir ) + lstrlenW( subdir ) >= ARRAY_SIZE(path)) return FALSE;
+    lstrcpyW( path, windows_dir );
+    lstrcatW( path, subdir );
+    return GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES;
+}
