+/* the CIM datetime string is 25 characters long: yyyymmddHHMMSS.mmmmmm+UUU   */
+/* an interval replaces the leading date with a day count and the UTC offset  */
+/* sign with a colon: ddddddddHHMMSS.mmmmmm:000                               */
+#define DATETIME_LEN 25
+#define TICKS_PER_MINUTE 600000000LL /* 60 * 1000 * 10000 */
+
+struct datetime
+{
+    ISWbemDateTime ISWbemDateTime_iface;
+    LONG refs;
+
+    LONG year, month, day, hours, minutes, seconds, microseconds;
+    LONG utc; /* offset in minutes */
+    BOOL year_specified, month_specified, day_specified, hours_specified;
+    BOOL minutes_specified, seconds_specified, microseconds_specified, utc_specified;
+
+    BOOL is_interval;
+};
+
+static inline struct datetime *impl_from_ISWbemDateTime( ISWbemDateTime *iface )
+{
+    return CONTAINING_RECORD( iface, struct datetime, ISWbemDateTime_iface );
+}
+
+/* format a fixed width, zero padded decimal field, or a run of '*' wildcards */
+static void put_field( WCHAR *dst, int width, LONG value, BOOL specified )
+{
+    int i;
+
+    if (!specified)
+    {
+        for (i = 0; i < width; i++) dst[i] = '*';
+        return;
+    }
+    for (i = width - 1; i >= 0; i--)
+    {
+        dst[i] = '0' + value % 10;
+        value /= 10;
+    }
+}
+
+static BOOL all_specified( const struct datetime *dt )
+{
+    return dt->year_specified && dt->month_specified && dt->day_specified &&
+           dt->hours_specified && dt->minutes_specified && dt->seconds_specified &&
+           dt->microseconds_specified && dt->utc_specified;
+}
+
+/* convert the stored components to a FILETIME, treating them as UTC */
+static BOOL components_to_filetime( const struct datetime *dt, ULONGLONG *ret )
+{
+    SYSTEMTIME st;
+    FILETIME ft;
+
+    st.wYear = dt->year;
+    st.wMonth = dt->month;
+    st.wDay = dt->day;
+    st.wHour = dt->hours;
+    st.wMinute = dt->minutes;
+    st.wSecond = dt->seconds;
+    st.wMilliseconds = dt->microseconds / 1000;
+
+    if (!SystemTimeToFileTime( &st, &ft )) return FALSE;
+
+    *ret = ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    *ret += (dt->microseconds % 1000) * 10;
+    return TRUE;
+}
+
+static void apply_offset( ULONGLONG *ft, LONG utc )
+{
+    *ft -= (LONGLONG)utc * TICKS_PER_MINUTE;
+}
+
+static BOOL localize_filetime( ULONGLONG in, ULONGLONG *out )
+{
+    FILETIME ft, local;
+
+    ft.dwLowDateTime = (DWORD)in;
+    ft.dwHighDateTime = (DWORD)(in >> 32);
+    if (!FileTimeToLocalFileTime( &ft, &local )) return FALSE;
+    *out = ((ULONGLONG)local.dwHighDateTime << 32) | local.dwLowDateTime;
+    return TRUE;
+}
+
+static BOOL filetime_to_systemtime( ULONGLONG ft, SYSTEMTIME *st )
+{
+    FILETIME file;
+
+    file.dwLowDateTime = (DWORD)ft;
+    file.dwHighDateTime = (DWORD)(ft >> 32);
+    return FileTimeToSystemTime( &file, st );
+}
+
+/* number of minutes that 'local' is ahead of UTC, including daylight saving */
+static BOOL components_to_ticks( const SYSTEMTIME *st, ULONGLONG *ret )
+{
+    FILETIME ft;
+
+    if (!SystemTimeToFileTime( st, &ft )) return FALSE;
+    *ret = ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    return TRUE;
+}
+
+static LONG local_offset( const SYSTEMTIME *local )
+{
+    SYSTEMTIME utc;
+    ULONGLONG l, u;
+
+    if (!TzSpecificLocalTimeToSystemTime( NULL, local, &utc )) return 0;
+    if (!components_to_ticks( local, &l ) || !components_to_ticks( &utc, &u )) return 0;
+    return (LONGLONG)(l - u) / TICKS_PER_MINUTE;
+}
+
+static void filetime_to_decstr( ULONGLONG value, WCHAR *buf )
+{
+    WCHAR tmp[21];
+    int i, n = 0;
+
+    if (!value)
+    {
+        buf[0] = '0';
+        buf[1] = 0;
+        return;
+    }
+    while (value)
+    {
+        tmp[n++] = '0' + value % 10;
+        value /= 10;
+    }
+    for (i = 0; i < n; i++) buf[i] = tmp[n - 1 - i];
+    buf[n] = 0;
+}
+
+static BOOL parse_decstr( const WCHAR *str, ULONGLONG *ret )
+{
+    ULONGLONG value = 0;
+    unsigned int i;
+
+    for (i = 0; str[i]; i++)
+    {
+        ULONGLONG digit;
+
+        if (str[i] < '0' || str[i] > '9') return FALSE;
+        digit = str[i] - '0';
+        if (value > (~(ULONGLONG)0 - digit) / 10) return FALSE;
+        value = value * 10 + digit;
+    }
+    *ret = value;
+    return TRUE;
+}
+
+/* a field is either all digits or all '*' wildcards */
+static BOOL parse_field( const WCHAR *str, int len, BOOL *specified, LONG *value )
+{
+    BOOL digits = TRUE, stars = TRUE;
+    LONG v = 0;
+    int i;
+
+    for (i = 0; i < len; i++)
+    {
+        if (str[i] == '*') digits = FALSE;
+        else if (str[i] >= '0' && str[i] <= '9') stars = FALSE;
+        else return FALSE;
+    }
+    if (digits)
+    {
+        for (i = 0; i < len; i++) v = v * 10 + (str[i] - '0');
+        *specified = TRUE;
+        *value = v;
+        return TRUE;
+    }
+    if (stars)
+    {
+        *specified = FALSE;
+        *value = 0;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static HRESULT put_value( struct datetime *dt, const WCHAR *str )
+{
+    BOOL yspec, mspec, dspec, hspec, mispec, sspec, uspec, utcspec = TRUE;
+    LONG year, month, day, hours, minutes, seconds, microseconds, utc;
+    BOOL interval;
+
+    TRACE( "%s\n", debugstr_w(str) );
+
+    if (!str || wcslen( str ) != DATETIME_LEN || str[14] != '.')
+        return WBEM_E_INVALID_SYNTAX;
+
+    if (str[21] == ':') interval = TRUE;
+    else if (str[21] == '+' || str[21] == '-') interval = FALSE;
+    else return WBEM_E_INVALID_SYNTAX;
+
+    if (interval)
+    {
+        if (!parse_field( str, 8, &dspec, &day )) return WBEM_E_INVALID_SYNTAX;
+        year = dt->year;
+        month = dt->month;
+        yspec = dt->year_specified;
+        mspec = dt->month_specified;
+        utc = 0;
+        utcspec = TRUE;
+    }
+    else
+    {
+        if (!parse_field( str, 4, &yspec, &year )) return WBEM_E_INVALID_SYNTAX;
+        if (!parse_field( str + 4, 2, &mspec, &month )) return WBEM_E_INVALID_SYNTAX;
+        if (!parse_field( str + 6, 2, &dspec, &day )) return WBEM_E_INVALID_SYNTAX;
+        if (!parse_field( str + 22, 3, &utcspec, &utc )) return WBEM_E_INVALID_SYNTAX;
+        if (str[21] == '-') utc = -utc;
+    }
+    if (!parse_field( str + 8, 2, &hspec, &hours )) return WBEM_E_INVALID_SYNTAX;
+    if (!parse_field( str + 10, 2, &mispec, &minutes )) return WBEM_E_INVALID_SYNTAX;
+    if (!parse_field( str + 12, 2, &sspec, &seconds )) return WBEM_E_INVALID_SYNTAX;
+    if (!parse_field( str + 15, 6, &uspec, &microseconds )) return WBEM_E_INVALID_SYNTAX;
+
+    dt->year = year;
+    dt->month = month;
+    dt->day = day;
+    dt->hours = hours;
+    dt->minutes = minutes;
+    dt->seconds = seconds;
+    dt->microseconds = microseconds;
+    dt->utc = utc;
+    dt->year_specified = yspec;
+    dt->month_specified = mspec;
+    dt->day_specified = dspec;
+    dt->hours_specified = hspec;
+    dt->minutes_specified = mispec;
+    dt->seconds_specified = sspec;
+    dt->microseconds_specified = uspec;
+    dt->utc_specified = utcspec;
+    dt->is_interval = interval;
+    return S_OK;
+}
+
+static ULONG WINAPI datetime_AddRef( ISWbemDateTime *iface )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    return InterlockedIncrement( &dt->refs );
+}
+
+static ULONG WINAPI datetime_Release( ISWbemDateTime *iface )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    LONG refs = InterlockedDecrement( &dt->refs );
+    if (!refs)
+    {
+        TRACE( "destroying %p\n", dt );
+        free( dt );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI datetime_QueryInterface( ISWbemDateTime *iface, REFIID riid, void **obj )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IDispatch ) ||
+        IsEqualGUID( riid, &IID_ISWbemDateTime ))
+    {
+        *obj = iface;
+        ISWbemDateTime_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI datetime_GetTypeInfoCount( ISWbemDateTime *iface, UINT *count )
+{
+    TRACE( "%p, %p\n", iface, count );
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI datetime_GetTypeInfo( ISWbemDateTime *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    TRACE( "%p, %u, %#lx, %p\n", iface, index, lcid, info );
+    return get_typeinfo( ISWbemDateTime_tid, info );
+}
+
+static HRESULT WINAPI datetime_GetIDsOfNames( ISWbemDateTime *iface, REFIID riid, LPOLESTR *names,
+                                              UINT count, LCID lcid, DISPID *dispid )
+{
+    ITypeInfo *typeinfo;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %p, %u, %#lx, %p\n", iface, debugstr_guid(riid), names, count, lcid, dispid );
+
+    if (!names || !count || !dispid) return E_INVALIDARG;
+
+    hr = get_typeinfo( ISWbemDateTime_tid, &typeinfo );
+    if (SUCCEEDED(hr))
+    {
+        hr = ITypeInfo_GetIDsOfNames( typeinfo, names, count, dispid );
+        ITypeInfo_Release( typeinfo );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI datetime_Invoke( ISWbemDateTime *iface, DISPID member, REFIID riid, LCID lcid,
+                                       WORD flags, DISPPARAMS *params, VARIANT *result,
+                                       EXCEPINFO *excep_info, UINT *arg_err )
+{
+    ITypeInfo *typeinfo;
+    HRESULT hr;
+
+    TRACE( "%p, %ld, %s, %#lx, %#x, %p, %p, %p, %p\n", iface, member, debugstr_guid(riid), lcid,
+           flags, params, result, excep_info, arg_err );
+
+    hr = get_typeinfo( ISWbemDateTime_tid, &typeinfo );
+    if (SUCCEEDED(hr))
+    {
+        hr = ITypeInfo_Invoke( typeinfo, iface, member, flags, params, result, excep_info, arg_err );
+        ITypeInfo_Release( typeinfo );
+    }
+    return hr;
+}
