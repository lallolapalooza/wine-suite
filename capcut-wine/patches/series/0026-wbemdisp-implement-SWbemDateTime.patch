+static void test_datetime(void)
+{
+    static const WCHAR value1[] = L"20000120195632.000000+000";
+    static const WCHAR value2[] = L"20000120195632.000000-480";
+    static const WCHAR value3[] = L"00000100010003.000000:000";
+    SYSTEMTIME st;
+    ISWbemDateTime *dt, *dt2;
+    IUnknown *unk;
+    BSTR str, str2;
+    DATE date, expected;
+    VARIANT_BOOL b;
+    ULONGLONG v;
+    FILETIME ft;
+    WCHAR buf[32];
+    LONG l;
+    HRESULT hr;
+
+    hr = CoCreateInstance( &CLSID_SWbemDateTime, NULL, CLSCTX_INPROC_SERVER,
+                           &IID_ISWbemDateTime, (void **)&dt );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (!dt) return;
+
+    hr = ISWbemDateTime_QueryInterface( dt, &IID_IDispatch, (void **)&unk );
+    ok( hr == S_OK, "QueryInterface(IDispatch) got %#lx\n", hr );
+    if (unk) IUnknown_Release( unk );
+
+    hr = ISWbemDateTime_QueryInterface( dt, &IID_ISWbemDateTime, (void **)&unk );
+    ok( hr == S_OK, "QueryInterface(ISWbemDateTime) got %#lx\n", hr );
+    if (unk) IUnknown_Release( unk );
+
+    /* Value <-> VT_DATE round trip */
+    str = SysAllocString( value1 );
+    hr = ISWbemDateTime_put_Value( dt, str );
+    SysFreeString( str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    str = NULL;
+    hr = ISWbemDateTime_get_Value( dt, &str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( str, value1 ), "got %s\n", wine_dbgstr_w( str ) );
+    SysFreeString( str );
+
+    memset( &st, 0, sizeof(st) );
+    st.wYear = 2000; st.wMonth = 1; st.wDay = 20;
+    st.wHour = 19; st.wMinute = 56; st.wSecond = 32;
+    hr = SystemTimeToVariantTime( &st, &expected );
+    ok( hr, "SystemTimeToVariantTime failed\n" );
+
+    date = 0.0;
+    hr = ISWbemDateTime_GetVarDate( dt, VARIANT_FALSE, &date );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( date > expected - 1e-7 && date < expected + 1e-7, "got %f expected %f\n", date, expected );
+
+    hr = ISWbemDateTime_SetVarDate( dt, expected, VARIANT_FALSE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    str = NULL;
+    hr = ISWbemDateTime_get_Value( dt, &str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( str, value1 ), "got %s\n", wine_dbgstr_w( str ) );
+    SysFreeString( str );
+
+    /* an explicit UTC offset: the Value holds the local wall clock plus the offset */
+    str = SysAllocString( value2 );
+    hr = ISWbemDateTime_put_Value( dt, str );
+    SysFreeString( str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    l = 0xdeadbeef;
+    hr = ISWbemDateTime_get_UTC( dt, &l );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( l == -480, "got %ld\n", l );
+
+    memset( &st, 0, sizeof(st) );
+    st.wYear = 2000; st.wMonth = 1; st.wDay = 21;
+    st.wHour = 3; st.wMinute = 56; st.wSecond = 32;
+    hr = SystemTimeToVariantTime( &st, &expected );
+    ok( hr, "SystemTimeToVariantTime failed\n" );
+
+    date = 0.0;
+    hr = ISWbemDateTime_GetVarDate( dt, VARIANT_FALSE, &date );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( date > expected - 1e-7 && date < expected + 1e-7, "got %f expected %f\n", date, expected );
+
+    /* FILETIME round trip, UTC interpretation */
+    hr = SystemTimeToFileTime( &st, &ft );
+    ok( hr, "SystemTimeToFileTime failed\n" );
+    v = ((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    swprintf( buf, ARRAY_SIZE(buf), L"%I64u", v );
+
+    str = NULL;
+    hr = ISWbemDateTime_GetFileTime( dt, VARIANT_FALSE, &str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( str, buf ), "got %s expected %s\n", wine_dbgstr_w( str ), wine_dbgstr_w( buf ) );
+
+    hr = CoCreateInstance( &CLSID_SWbemDateTime, NULL, CLSCTX_INPROC_SERVER,
+                           &IID_ISWbemDateTime, (void **)&dt2 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (dt2)
+    {
+        str2 = NULL;
+        hr = ISWbemDateTime_SetFileTime( dt2, str, VARIANT_FALSE );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        hr = ISWbemDateTime_GetFileTime( dt2, VARIANT_FALSE, &str2 );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( !wcscmp( str2, buf ), "got %s expected %s\n", wine_dbgstr_w( str2 ), wine_dbgstr_w( buf ) );
+        SysFreeString( str2 );
+        ISWbemDateTime_Release( dt2 );
+    }
+    SysFreeString( str );
+
+    /* interval */
+    str = SysAllocString( value3 );
+    hr = ISWbemDateTime_put_Value( dt, str );
+    SysFreeString( str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    b = VARIANT_FALSE;
+    hr = ISWbemDateTime_get_IsInterval( dt, &b );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( b == VARIANT_TRUE, "got %d\n", b );
+
+    l = 0;
+    ISWbemDateTime_get_Day( dt, &l );
+    ok( l == 100, "got %ld\n", l );
+    l = 0;
+    ISWbemDateTime_get_Hours( dt, &l );
+    ok( l == 1, "got %ld\n", l );
+    l = 0;
+    ISWbemDateTime_get_Seconds( dt, &l );
+    ok( l == 3, "got %ld\n", l );
+
+    hr = ISWbemDateTime_GetVarDate( dt, VARIANT_FALSE, &date );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+    hr = ISWbemDateTime_GetFileTime( dt, VARIANT_FALSE, &str );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+
+    str = NULL;
+    hr = ISWbemDateTime_get_Value( dt, &str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( str, value3 ), "got %s\n", wine_dbgstr_w( str ) );
+    SysFreeString( str );
+
+    /* build the same interval from its components */
+    hr = CoCreateInstance( &CLSID_SWbemDateTime, NULL, CLSCTX_INPROC_SERVER,
+                           &IID_ISWbemDateTime, (void **)&dt2 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (dt2)
+    {
+        ISWbemDateTime_put_IsInterval( dt2, VARIANT_TRUE );
+        ISWbemDateTime_put_Day( dt2, 100 );
+        ISWbemDateTime_put_Hours( dt2, 1 );
+        ISWbemDateTime_put_Seconds( dt2, 3 );
+        str = NULL;
+        hr = ISWbemDateTime_get_Value( dt2, &str );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( !wcscmp( str, value3 ), "got %s\n", wine_dbgstr_w( str ) );
+        SysFreeString( str );
+        ISWbemDateTime_Release( dt2 );
+    }
+
+    /* malformed input leaves the object unchanged */
+    str = SysAllocString( L"garbage" );
+    hr = ISWbemDateTime_put_Value( dt, str );
+    SysFreeString( str );
+    ok( hr == WBEM_E_INVALID_SYNTAX, "got %#lx\n", hr );
+
+    str = SysAllocString( L"20000120195632.000000" ); /* no UTC offset */
+    hr = ISWbemDateTime_put_Value( dt, str );
+    SysFreeString( str );
+    ok( hr == WBEM_E_INVALID_SYNTAX, "got %#lx\n", hr );
+
+    str = NULL;
+    hr = ISWbemDateTime_get_Value( dt, &str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( str, value3 ), "got %s\n", wine_dbgstr_w( str ) );
+    SysFreeString( str );
+
+    str = SysAllocString( L"abc" );
+    hr = ISWbemDateTime_SetFileTime( dt, str, VARIANT_FALSE );
+    SysFreeString( str );
+    ok( hr == WBEM_E_INVALID_SYNTAX, "got %#lx\n", hr );
+
+    ISWbemDateTime_Release( dt );
+}
+
