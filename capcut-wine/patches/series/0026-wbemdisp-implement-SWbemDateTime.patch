+}
+
+static HRESULT WINAPI datetime_put_Microseconds( ISWbemDateTime *iface, LONG value )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    if (value < 0 || value > 999999) return WBEM_E_VALUE_OUT_OF_RANGE;
+    dt->microseconds = value;
+    return S_OK;
+}
+
