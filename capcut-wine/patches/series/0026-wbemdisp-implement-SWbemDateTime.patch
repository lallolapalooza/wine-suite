+static HRESULT WINAPI datetime_get_Value( ISWbemDateTime *iface, BSTR *value )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    WCHAR buf[DATETIME_LEN + 1];
+
+    TRACE( "%p, %p\n", dt, value );
+
+    if (dt->is_interval)
+    {
+        put_field( buf, 8, dt->day, dt->day_specified );
+        put_field( buf + 8, 2, dt->hours, dt->hours_specified );
+        put_field( buf + 10, 2, dt->minutes, dt->minutes_specified );
+        put_field( buf + 12, 2, dt->seconds, dt->seconds_specified );
+        buf[14] = '.';
+        put_field( buf + 15, 6, dt->microseconds, dt->microseconds_specified );
+        buf[21] = ':';
+        put_field( buf + 22, 3, 0, TRUE );
+    }
+    else
+    {
+        put_field( buf, 4, dt->year, dt->year_specified );
+        put_field( buf + 4, 2, dt->month, dt->month_specified );
+        put_field( buf + 6, 2, dt->day, dt->day_specified );
+        put_field( buf + 8, 2, dt->hours, dt->hours_specified );
+        put_field( buf + 10, 2, dt->minutes, dt->minutes_specified );
+        put_field( buf + 12, 2, dt->seconds, dt->seconds_specified );
+        buf[14] = '.';
+        put_field( buf + 15, 6, dt->microseconds, dt->microseconds_specified );
+        buf[21] = dt->utc < 0 ? '-' : '+';
+        put_field( buf + 22, 3, abs( dt->utc ), dt->utc_specified );
+    }
+    buf[DATETIME_LEN] = 0;
+
+    if (!(*value = SysAllocString( buf ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT WINAPI datetime_put_Value( ISWbemDateTime *iface, BSTR value )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+
+    TRACE( "%p, %s\n", dt, debugstr_w(value) );
+
+    return put_value( dt, value );
+}
