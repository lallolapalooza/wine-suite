+    return S_OK;
+}
+
+static HRESULT WINAPI datetime_GetVarDate( ISWbemDateTime *iface, VARIANT_BOOL local, DATE *ret )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    SYSTEMTIME st;
+    ULONGLONG ft;
+
+    TRACE( "%p, %d, %p\n", dt, local, ret );
+
+    if (dt->is_interval) return WBEM_E_FAILED;
+    if (!all_specified( dt )) return WBEM_E_FAILED;
+    if (!components_to_filetime( dt, &ft )) return WBEM_E_INVALID_SYNTAX;
+
+    apply_offset( &ft, dt->utc );
+    if (local && !localize_filetime( ft, &ft )) return WBEM_E_FAILED;
+    if (!filetime_to_systemtime( ft, &st )) return WBEM_E_INVALID_SYNTAX;
+    if (!SystemTimeToVariantTime( &st, ret )) return WBEM_E_INVALID_SYNTAX;
+    return S_OK;
+}
+
+static HRESULT WINAPI datetime_SetVarDate( ISWbemDateTime *iface, DATE date, VARIANT_BOOL local )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    SYSTEMTIME st;
+
+    TRACE( "%p, %f, %d\n", dt, date, local );
+
+    if (!VariantTimeToSystemTime( date, &st )) return WBEM_E_INVALID_SYNTAX;
+
+    dt->year = st.wYear;
+    dt->month = st.wMonth;
+    dt->day = st.wDay;
+    dt->hours = st.wHour;
+    dt->minutes = st.wMinute;
+    dt->seconds = st.wSecond;
+    dt->microseconds = st.wMilliseconds * 1000;
+    dt->utc = local ? local_offset( &st ) : 0;
+    dt->year_specified = dt->month_specified = dt->day_specified = TRUE;
+    dt->hours_specified = dt->minutes_specified = dt->seconds_specified = TRUE;
+    dt->microseconds_specified = dt->utc_specified = TRUE;
+    dt->is_interval = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI datetime_GetFileTime( ISWbemDateTime *iface, VARIANT_BOOL local, BSTR *ret )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    WCHAR buf[21];
+    ULONGLONG ft;
+
+    TRACE( "%p, %d, %p\n", dt, local, ret );
+
+    if (dt->is_interval) return WBEM_E_FAILED;
+    if (!all_specified( dt )) return WBEM_E_FAILED;
+    if (!components_to_filetime( dt, &ft )) return WBEM_E_INVALID_SYNTAX;
+
+    apply_offset( &ft, dt->utc );
+    if (local && !localize_filetime( ft, &ft )) return WBEM_E_FAILED;
+    filetime_to_decstr( ft, buf );
+
+    if (!(*ret = SysAllocString( buf ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT WINAPI datetime_SetFileTime( ISWbemDateTime *iface, BSTR str, VARIANT_BOOL local )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    SYSTEMTIME st;
+    ULONGLONG ft;
+
+    TRACE( "%p, %s, %d\n", dt, debugstr_w(str), local );
+
+    if (!parse_decstr( str, &ft )) return WBEM_E_INVALID_SYNTAX;
+    if (!filetime_to_systemtime( ft, &st )) return WBEM_E_INVALID_SYNTAX;
+
+    dt->year = st.wYear;
+    dt->month = st.wMonth;
+    dt->day = st.wDay;
+    dt->hours = st.wHour;
+    dt->minutes = st.wMinute;
+    dt->seconds = st.wSecond;
+    dt->microseconds = st.wMilliseconds * 1000;
+    dt->utc = local ? local_offset( &st ) : 0;
+    dt->year_specified = dt->month_specified = dt->day_specified = TRUE;
+    dt->hours_specified = dt->minutes_specified = dt->seconds_specified = TRUE;
+    dt->microseconds_specified = dt->utc_specified = TRUE;
+    dt->is_interval = FALSE;
+    return S_OK;
+}
+
+static const ISWbemDateTimeVtbl datetime_vtbl =
+{
+    datetime_QueryInterface,
+    datetime_AddRef,
+    datetime_Release,
+    datetime_GetTypeInfoCount,
+    datetime_GetTypeInfo,
+    datetime_GetIDsOfNames,
+    datetime_Invoke,
+    datetime_get_Value,
+    datetime_put_Value,
+    datetime_get_Year,
+    datetime_put_Year,
+    datetime_get_YearSpecified,
+    datetime_put_YearSpecified,
+    datetime_get_Month,
+    datetime_put_Month,
+    datetime_get_MonthSpecified,
+    datetime_put_MonthSpecified,
+    datetime_get_Day,
+    datetime_put_Day,
+    datetime_get_DaySpecified,
+    datetime_put_DaySpecified,
+    datetime_get_Hours,
+    datetime_put_Hours,
+    datetime_get_HoursSpecified,
+    datetime_put_HoursSpecified,
+    datetime_get_Minutes,
+    datetime_put_Minutes,
+    datetime_get_MinutesSpecified,
+    datetime_put_MinutesSpecified,
+    datetime_get_Seconds,
+    datetime_put_Seconds,
+    datetime_get_SecondsSpecified,
+    datetime_put_SecondsSpecified,
+    datetime_get_Microseconds,
+    datetime_put_Microseconds,
+    datetime_get_MicrosecondsSpecified,
+    datetime_put_MicrosecondsSpecified,
+    datetime_get_UTC,
+    datetime_put_UTC,
+    datetime_get_UTCSpecified,
+    datetime_put_UTCSpecified,
+    datetime_get_IsInterval,
+    datetime_put_IsInterval,
+    datetime_GetVarDate,
+    datetime_SetVarDate,
+    datetime_GetFileTime,
+    datetime_SetFileTime
+};
+
+HRESULT SWbemDateTime_create( LPVOID *obj )
+{
+    struct datetime *dt;
+
+    TRACE( "%p\n", obj );
+
+    if (!(dt = malloc( sizeof(*dt) ))) return E_OUTOFMEMORY;
+    dt->ISWbemDateTime_iface.lpVtbl = &datetime_vtbl;
+    dt->refs = 1;
+
+    dt->year = 0;
+    dt->month = 1;
+    dt->day = 1;
+    dt->hours = 0;
+    dt->minutes = 0;
+    dt->seconds = 0;
+    dt->microseconds = 0;
+    dt->utc = 0;
+    dt->year_specified = dt->month_specified = dt->day_specified = TRUE;
+    dt->hours_specified = dt->minutes_specified = dt->seconds_specified = TRUE;
+    dt->microseconds_specified = dt->utc_specified = TRUE;
+    dt->is_interval = FALSE;
+
+    *obj = &dt->ISWbemDateTime_iface;
+    TRACE( "returning iface %p\n", *obj );
+    return S_OK;
+}
