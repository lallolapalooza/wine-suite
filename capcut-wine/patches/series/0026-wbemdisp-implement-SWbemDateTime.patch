+static HRESULT WINAPI datetime_put_Day( ISWbemDateTime *iface, LONG value )
+{
+    struct datetime *dt = impl_from_ISWbemDateTime( iface );
+    if (dt->is_interval)
+    {
+        if (value < 0 || value > 99999999) return WBEM_E_VALUE_OUT_OF_RANGE;
