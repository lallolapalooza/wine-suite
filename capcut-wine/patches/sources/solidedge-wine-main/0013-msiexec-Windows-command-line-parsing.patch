-            case ' ':
-                break;
-            case '"':
-                state = CS_QUOTE;
-                count++;
-                ignore = FALSE;
-                break;
-            default:
+                if (q) *q++ = 0;
                 count++;
-                ignore = FALSE;
-                state = CS_TOKEN;
+                in_arg = FALSE;
             }
-            break;
-
-        case CS_TOKEN:
-            switch (*p)
+            bcount = 0;
+        }
+        else if (*p == '\\')
+        {
+            if (q) *q++ = *p;
+            bcount++;
+            p++;
+        }
+        else if (*p == '"')
+        {
+            if (bcount & 1)
             {
-            case '"':
-                state = CS_QUOTE;
-                ignore = FALSE;
-                break;
